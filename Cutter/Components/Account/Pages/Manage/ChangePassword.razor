@page "/Account/Manage/ChangePassword"
@attribute [Authorize]
@layout Cutter.Components.Account.Shared.ManageLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Cutter.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

<PageTitle>Изменение пароля</PageTitle>

<h3 class="profile-title">🔑 Изменение пароля</h3>
<StatusMessage Message="@message" />

<div class="row">
    <div class="col-xl-8">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword"
                           class="form-control" autocomplete="current-password"
                           aria-required="true" placeholder="Старый пароль"
                           disabled="@isSubmitting" />
                <label for="Input.OldPassword" class="form-label">Старый пароль</label>
                <ValidationMessage For="() => Input.OldPassword" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword"
                           class="form-control" autocomplete="new-password"
                           aria-required="true" placeholder="Новый пароль"
                           disabled="@isSubmitting" />
                <label for="Input.NewPassword" class="form-label">Новый пароль</label>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
                <small class="form-text text-muted">Минимум 6 символов</small>
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword"
                           class="form-control" autocomplete="new-password"
                           aria-required="true" placeholder="Подтвердить новый пароль"
                           disabled="@isSubmitting" />
                <label for="Input.ConfirmPassword" class="form-label">Подтвердите новый пароль</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-warning" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Смена пароля...</span>
                }
                else
                {
                    <i class="bi bi-key-fill me-2"></i>
                    <span>Изменить пароль</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool hasPassword;
    private bool isSubmitting = false; // 👈 Флаг блокировки формы

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (isSubmitting) return; // 👈 Защита от повторного вызова

        isSubmitting = true; // 👈 Блокируем форму
        StateHasChanged();   // 👈 Обновляем UI — появляется спиннер

        try
        {
            var changePasswordResult = await UserManager.ChangePasswordAsync(
                user, Input.OldPassword, Input.NewPassword);

            if (!changePasswordResult.Succeeded)
            {
                message = $"Ошибка: {string.Join(", ", changePasswordResult.Errors.Select(error => error.Description))}";
                return;
            }

            await SignInManager.RefreshSignInAsync(user);
            Logger.LogInformation("User changed their password successfully.");

            RedirectManager.RedirectToCurrentPageWithStatus(
                "Ваш пароль успешно изменён", HttpContext);
        }
        finally
        {
            isSubmitting = false; // 👈 Всегда разблокируем форму
            StateHasChanged();
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Введите текущий пароль")]
        [DataType(DataType.Password)]
        [Display(Name = "Текущий пароль")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Введите новый пароль")]
        [StringLength(100, ErrorMessage = "{0} должен содержать от {2} до {1} символов.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Новый пароль")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Подтверждение пароля")]
        [Compare("NewPassword", ErrorMessage = "Пароли не совпадают.")]
        public string ConfirmPassword { get; set; } = "";
    }
}