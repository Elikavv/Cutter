@page "/admin-super"
@attribute [Authorize(Roles = "AdminSuper")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Cutter.Services
@inject CuttingService CuttingService

<PageTitle>Панель суперадминистратора</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4">Панель суперадминистратора</h2>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (dashboard != null)
    {
        <!-- Фильтры -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <!-- Фильтр по периоду -->
                    <div class="col-md-3">
                        <label class="form-label">Дата с</label>
                        <input type="date" class="form-control" @bind="startDate" @bind:after="ApplyFiltersAsync" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Дата по</label>
                        <input type="date" class="form-control" @bind="endDate" @bind:after="ApplyFiltersAsync" />
                    </div>

                    <!-- Фильтр по магазинам -->
                    <div class="col-md-3">
                        <label class="form-label">Магазины</label>
                        <select class="form-select" @onchange="OnStoreFilterChange" multiple size="1">
                            @foreach (var store in dashboard.AllStores)
                            {
                                <option value="@store.Id" selected="@(selectedStoreIds.Contains(store.Id))">@store.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Фильтр по пользователям -->
                    <div class="col-md-3">
                        <label class="form-label">Пользователи</label>
                        <select class="form-select" @onchange="OnUserFilterChange" multiple size="1">
                            @foreach (var user in dashboard.AllUsers)
                            {
                                <option value="@user.Id" selected="@(selectedUserIds.Contains(user.Id))">@user.UserName (@user.Store?.Name)</option>
                            }
                        </select>
                    </div>

                    <!-- Фильтр по статусу -->
                    <div class="col-md-12 mt-3">
                        <label class="form-label d-block">Статус</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="showSaved" @onchange="@(e => ToggleStatusFilterAsync(true, e))" checked="@showSaved" />
                            <label class="form-check-label" for="showSaved">Сохранено</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="showDrafts" @onchange="@(e => ToggleStatusFilterAsync(false, e))" checked="@showDrafts" />
                            <label class="form-check-label" for="showDrafts">Черновики</label>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary ms-3" @onclick="ResetFilters">Сбросить фильтры</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Статистика по фильтру -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <h6 class="card-title text-primary">Распиловок</h6>
                        <h4>@dashboard.Summary.TotalPlans</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <h6 class="card-title text-success">Резов</h6>
                        <h4>@dashboard.Summary.TotalCuts</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-info">
                    <div class="card-body text-center">
                        <h6 class="card-title text-info">Сумма услуг</h6>
                        <h4>@dashboard.Summary.TotalServicesAmount.ToString("N0") ₽</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <h6 class="card-title text-warning">Сумма листов</h6>
                        <h4>@dashboard.Summary.TotalSheetsAmount.ToString("N0") ₽</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Таблица распиловок -->
        <h4>Распиловки (@dashboard.Plans.Count)</h4>
        @if (dashboard.Plans.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Номер</th>
                            <th>Магазин</th>
                            <th>Пользователь</th>
                            <th>Статус</th>
                            <th>Резов</th>
                            <th>Сумма услуг</th>
                            <th>Сумма листов</th>
                            <th>Итого</th>
                            <th>Время</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in dashboard.Plans)
                        {
                            <tr class="@(item.IsSave ? "" : "table-warning")" style="cursor: pointer;" @onclick="@(() => Navigation.NavigateTo("/cut/" + item.GUUID))">
                                <td>
                                    <code>@item.NumCut</code>
                                    @if (!item.IsSave)
                                    {
                                        <span title="Черновик" class="ms-1">📝</span>
                                    }
                                </td>
                                <td>@item.StoreName</td>
                                <td>@item.UserName</td>
                                <td>
                                    @if (item.IsSave)
                                    {
                                        <span class="badge bg-success">Сохранено</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Черновик</span>
                                    }
                                </td>
                                <td>@item.TotalCuts</td>
                                <td>@item.TotalServicesAmount.ToString("N0") ₽</td>
                                <td>@item.TotalSheetsAmount.ToString("N0") ₽</td>
                                <td class="fw-bold">@item.TotalAmount.ToString("N0") ₽</td>
                                <td>@item.CreateDate.ToString("dd.MM HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">Нет распиловок по выбранному фильтру.</div>
        }
    }
</div>

@code {
    [Inject] public NavigationManager Navigation { get; set; } = default!;

    private bool isLoading = true;
    private AdminDashboardDto? dashboard;

    // Состояние фильтров
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today;
    private HashSet<Guid> selectedStoreIds = new();
    private HashSet<string> selectedUserIds = new();
    private bool showSaved = true;
    private bool showDrafts = true;

    protected override async Task OnInitializedAsync()
    {
        // Первичная загрузка данных
        await ApplyFiltersAsync();
    }

    // Единый метод применения фильтров через сервис
    private async Task ApplyFiltersAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            dashboard = await CuttingService.GetAdminDashboardAsync(
                startDate,
                endDate,
                selectedStoreIds,
                selectedUserIds,
                showSaved,
                showDrafts
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки дашборда: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // Обработчики изменений фильтров
    private void OnStoreFilterChange(ChangeEventArgs e)
    {
        selectedStoreIds.Clear();
        if (e.Value is string[] values)
        {
            foreach (var v in values)
            {
                if (Guid.TryParse(v, out var id))
                    selectedStoreIds.Add(id);
            }
        }
        _ = ApplyFiltersAsync();
    }

    private void OnUserFilterChange(ChangeEventArgs e)
    {
        selectedUserIds.Clear();
        if (e.Value is string[] values)
        {
            selectedUserIds.UnionWith(values);
        }
        _ = ApplyFiltersAsync();
    }

    private async Task ToggleStatusFilterAsync(bool isSaved, ChangeEventArgs e)
    {
        if (isSaved)
            showSaved = (bool)(e.Value ?? false);
        else
            showDrafts = (bool)(e.Value ?? false);

        await ApplyFiltersAsync();
    }

    private async Task ResetFilters()
    {
        startDate = DateTime.Today;
        endDate = DateTime.Today;

        if (dashboard != null)
        {
            selectedStoreIds = new(dashboard.AllStores.Select(s => s.Id));
            selectedUserIds = new(dashboard.AllUsers.Select(u => u.Id));
        }

        showSaved = true;
        showDrafts = true;

        await ApplyFiltersAsync();
    }
}