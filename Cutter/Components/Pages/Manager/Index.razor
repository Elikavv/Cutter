@page "/manager"
@attribute [Authorize(Roles = "Manager, AdminSuper")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Cutter.Services
@inject CuttingService CuttingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Дашборд менеджера</PageTitle>

<div class="container-fluid mt-4">
    <!-- Заголовок и фильтры периода -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="mb-0">📊 Дашборд менеджера</h2>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <div class="btn-group" role="group">
                <button class="btn @(currentPeriod == Period.Today ? "btn-primary" : "btn-outline-dark")" @onclick="() => SetPeriod(Period.Today)">Сегодня</button>
                <button class="btn @(currentPeriod == Period.Week ? "btn-primary" : "btn-outline-dark")" @onclick="() => SetPeriod(Period.Week)">Неделя</button>
                <button class="btn @(currentPeriod == Period.Month ? "btn-primary" : "btn-outline-dark")" @onclick="() => SetPeriod(Period.Month)">Месяц</button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Загрузка...</span></div>
        </div>
    }
    else if (dashboard != null)
    {
        <!-- KPI Карточки -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card border-primary h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-1">Всего бланков</h6>
                        <h2 class="mb-0 text-primary">@dashboard.TotalPlans</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-1">Всего резов</h6>
                        <h2 class="mb-0 text-success">@dashboard.TotalCuts</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-info h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-1">Общая сумма</h6>
                        <h2 class="mb-0 text-info">@dashboard.TotalAmount.ToString("N0") ₽</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-1">Лучший сотрудник</h6>
                        @if (dashboard.TopEmployee != null)
                        {
                            <h4 class="mb-0 text-warning">@dashboard.TopEmployee.UserName</h4>
                            <small class="text-muted">@dashboard.TopEmployee.StoreName • @dashboard.TopEmployee.PlansCount бланков</small>
                        }
                        else
                        {
                            <h4 class="mb-0 text-muted">Нет данных</h4>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Статистика по магазинам -->
        @if (dashboard.StoreStats.Count > 1)
        {
            <h4 class="mb-3">🏪 Статистика по магазинам</h4>
            <div class="row g-4 mb-4">
                @foreach (var store in dashboard.StoreStats)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header bg-white">
                                <h5 class="mb-0">@store.StoreName</h5>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-4">
                                        <h6 class="text-muted">Бланков</h6>
                                        <h4 class="text-primary">@store.TotalPlans</h4>
                                    </div>
                                    <div class="col-4">
                                        <h6 class="text-muted">Резов</h6>
                                        <h4 class="text-success">@store.TotalCuts</h4>
                                    </div>
                                    <div class="col-4">
                                        <h6 class="text-muted">Сумма</h6>
                                        <h4 class="text-info">@store.TotalAmount.ToString("N0") ₽</h4>
                                    </div>
                                </div>
                                <hr />
                                <h6 class="text-muted">Сотрудники:</h6>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var emp in store.Employees.OrderByDescending(e => e.TotalAmount))
                                    {
                                        <li class="d-flex justify-content-between">
                                            <span>@emp.UserName</span>
                                            <span class="badge bg-primary">@emp.TotalAmount.ToString("N0") ₽</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- График и Топ сотрудников -->
        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">📈 Динамика по дням</h5>
                    </div>
                    <div class="card-body">
                        <div style="height: 300px;">
                            <canvas id="managerTrendChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"> Рейтинг сотрудников</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var emp in dashboard.TopEmployees.Take(5))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@emp.UserName</strong>
                                        <br /><small class="text-muted">@emp.StoreName • @emp.PlansCount бланков</small>
                                    </div>
                                    <span class="badge bg-primary rounded-pill">@emp.TotalAmount.ToString("N0") ₽</span>
                                </div>
                            }
                            @if (!dashboard.TopEmployees.Any())
                            {
                                <div class="list-group-item text-center text-muted py-4">Нет данных за выбранный период</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Последние бланки -->
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">📋 Последние бланки</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Номер</th>
                                <th>Магазин</th>
                                <th>Сотрудник</th>
                                <th>Время</th>
                                <th>Сумма</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plan in dashboard.RecentPlans)
                            {
                                <tr style="cursor: pointer;" @onclick="@(() => Navigation.NavigateTo("/cut/" + plan.GUUID))">
                                    <td><code>@plan.NumCut</code></td>
                                    <td><small>@plan.StoreName</small></td>
                                    <td>@plan.UserName</td>
                                    <td>@plan.CreateDate.ToString("dd.MM HH:mm")</td>
                                    <td class="text-end fw-bold text-primary">@plan.TotalAmount.ToString("N0") ₽</td>
                                </tr>
                            }
                            @if (!dashboard.RecentPlans.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">Нет бланков за выбранный период</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script src="js/chart.js"></script>
<script src="js/dashboard.js"></script>

@code {
    private bool isLoading = true;
    private ManagerDashboardDto? dashboard;
    private Period currentPeriod = Period.Today;

    private bool dataLoaded = false;

    private enum Period { Today, Week, Month }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (dataLoaded && dashboard != null && dashboard.DailyStats.Any())
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("initManagerChart", dashboard.DailyStats);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка графика: {ex.Message}");
            }
        }
    }

    private async Task SetPeriod(Period period)
    {
        currentPeriod = period;
        await LoadDashboard(); // await здесь важен!
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        StateHasChanged();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var managerId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrEmpty(managerId))
        {
            isLoading = false;
            return;
        }

        var (startDate, endDate) = currentPeriod switch
        {
            Period.Today => (DateTime.Today, DateTime.Today),
            Period.Week => (DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek + 1), DateTime.Today),
            Period.Month => (new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1), DateTime.Today),
            _ => (DateTime.Today, DateTime.Today)
        };

        try
        {
            dashboard = await CuttingService.GetManagerDashboardAsync(managerId, startDate, endDate);
            dataLoaded = true; // ✅ Флаг: данные загружены
            StateHasChanged(); // Перерисовка, чтобы canvas появился в DOM
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task InitializeChart()
    {
        if (dashboard != null && dashboard.DailyStats.Any())
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("initManagerChart", "managerTrendChart", dashboard.DailyStats);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка инициализации графика: {ex.Message}");
            }
        }
    }
}