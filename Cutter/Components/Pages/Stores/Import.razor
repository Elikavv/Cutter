@page "/store/import"
@attribute [Authorize(Roles = "AdminStore, AdminSuper")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Cutter.Services
@using Cutter.Data
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IExcelImportService ImportService
@inject IStoreDepartmentService DepartmentService
@inject IStorePricingService PricingService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime

<PageTitle>Импорт товаров из Excel</PageTitle>

<div class="container-fluid py-4 px-4">
    <h2 style="color: #0055A4;" class="mb-4">📥 Импорт товаров из Excel</h2>

    @if (isAdminSuper)
    {
        <!-- Выбор магазина -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <label class="form-label fw-bold">🏪 Выберите магазин</label>
                <select class="form-select" @bind="selectedStoreId">
                    <option value="">-- Выберите магазин --</option>
                    @foreach (var store in availableStores)
                    {
                        <option value="@store.Id">@store.Name</option>
                    }
                </select>
            </div>
        </div>
    }

    @if (!isAdminSuper || selectedStoreId.HasValue)
    {
        <!-- Загрузка файла -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <label class="form-label fw-bold">📄 Файл Excel</label>
                <InputFile OnChange="OnFileSelected" accept=".xlsx,.xls" class="form-control" />
                @if (selectedFile != null)
                {
                    <div class="mt-2 text-success">
                        ✅ Выбран файл: <strong>@selectedFile.Name</strong> (@(selectedFile.Size / 1024) КБ)
                    </div>
                }
            </div>
        </div>

        <!-- Настройки импорта -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header fw-bold text-white" style="background-color: #0055A4;">
                ⚙️ Настройки импорта
            </div>
            <div class="card-body">
                <!-- Что импортировать -->
                <h6 class="fw-bold mb-3">📋 Что импортировать:</h6>
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.ImportName" id="importName" />
                            <label class="form-check-label" for="importName">Наименование</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.ImportSizes" id="importSizes" />
                            <label class="form-check-label" for="importSizes">Размеры (парсинг)</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.ImportPrice" id="importPrice" />
                            <label class="form-check-label" for="importPrice">Цена</label>
                        </div>
                    </div>
                </div>

                <!-- Справочники -->
                <h6 class="fw-bold mb-3"> Справочники:</h6>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.CreateNewDepartments" id="createDepts" />
                            <label class="form-check-label" for="createDepts">Создавать новые отделы</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.CreateNewSubdepartments" id="createSubdepts" />
                            <label class="form-check-label" for="createSubdepts">Создавать новые подотделы</label>
                        </div>
                    </div>
                </div>

                <!-- Новые товары -->
                <h6 class="fw-bold mb-3">🆕 Новые товары (которых нет нигде):</h6>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.CreateNewItems" id="createItems" />
                            <label class="form-check-label" for="createItems">Создавать в справочнике и магазине</label>
                        </div>
                    </div>
                </div>

                <!-- Товар есть в справочнике, но нет в магазине -->
                <h6 class="fw-bold mb-3">📦 Товар есть в справочнике, но нет в магазине:</h6>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.AddToStore" id="addToStore" />
                            <label class="form-check-label" for="addToStore">Добавлять привязку к магазину</label>
                        </div>
                    </div>
                </div>

                <!-- Обновление существующих -->
                <h6 class="fw-bold mb-3">🔄 Обновление существующих товаров:</h6>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.UpdateCatalog" id="updateCatalog" />
                            <label class="form-check-label" for="updateCatalog">Обновлять справочник (Items)</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="settings.UpdateStore" id="updateStore" />
                            <label class="form-check-label" for="updateStore">Обновлять магазин (StoreItems)</label>
                        </div>
                    </div>
                </div>

                <!-- Нулевая цена -->
                <h6 class="fw-bold mb-3">💰 Если цена нулевая:</h6>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Действие:</label>
                        <select class="form-select" @bind="settings.ZeroPriceAction">
                            <option value="@ZeroPriceAction.Skip">Не трогать (оставить старую)</option>
                            <option value="@ZeroPriceAction.Overwrite">Перезаписать (обнулить)</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Кнопка импорта -->
        <div class="d-grid gap-2 mb-4">
            <button class="btn text-white btn-lg" style="background-color: #0055A4;"
                    @onclick="StartImport"
                    disabled="@(selectedFile == null || isImporting)">
                @(isImporting ? "⏳ Импорт..." : "🚀 Начать импорт")
            </button>
        </div>

        <!-- Результат импорта -->
        @if (importResult != null)
        {
            <div class="card shadow-sm">
                <div class="card-header fw-bold text-white"
                     style="background-color: @(importResult.ErrorMessage != null ? "#E74C3C" : (importResult.ErrorsCount > 0 ? "#F58220" : "#27AE60"));">
                    @(importResult.ErrorMessage != null ? "❌ Ошибка импорта" : (importResult.ErrorsCount > 0 ? "⚠️ Импорт завершен с ошибками" : "✅ Импорт успешно завершен"))
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <div class="border rounded p-3 text-center">
                                <div class="text-muted small">Всего строк</div>
                                <div class="fs-4 fw-bold">@importResult.TotalRows</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border rounded p-3 text-center">
                                <div class="text-muted small">Создано товаров</div>
                                <div class="fs-4 fw-bold text-success">@importResult.CreatedItems</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border rounded p-3 text-center">
                                <div class="text-muted small">Обновлено</div>
                                <div class="fs-4 fw-bold text-primary">@importResult.UpdatedItems</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border rounded p-3 text-center">
                                <div class="text-muted small">Пропущено</div>
                                <div class="fs-4 fw-bold text-warning">@importResult.SkippedRows</div>
                            </div>
                        </div>
                    </div>

                    @if (importResult.CreatedDepartments > 0 || importResult.CreatedSubdepartments > 0)
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="border rounded p-3 text-center">
                                    <div class="text-muted small">Создано отделов</div>
                                    <div class="fs-5 fw-bold">@importResult.CreatedDepartments</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded p-3 text-center">
                                    <div class="text-muted small">Создано подотделов</div>
                                    <div class="fs-5 fw-bold">@importResult.CreatedSubdepartments</div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (importResult.Warnings.Any())
                    {
                        <div class="mt-3">
                            <h6 class="fw-bold">⚠️ Предупреждения (@importResult.Warnings.Count):</h6>
                            <div class="alert alert-info" style="max-height: 200px; overflow-y: auto;">
                                <ul class="mb-0">
                                    @foreach (var warning in importResult.Warnings.Take(20))
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                                @if (importResult.Warnings.Count > 20)
                                {
                                    <div class="mt-2 text-muted">
                                        ... и ещё @(importResult.Warnings.Count - 20) предупреждений
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (importResult.Errors.Any())
                    {
                        <div class="mt-3">
                            <h6 class="fw-bold"> Ошибки (@importResult.Errors.Count):</h6>
                            <div class="alert alert-warning" style="max-height: 300px; overflow-y: auto;">
                                <ul class="mb-0">
                                    @foreach (var error in importResult.Errors.Take(50))
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                                @if (importResult.Errors.Count > 50)
                                {
                                    <div class="mt-2 text-muted">
                                        ... и ещё @(importResult.Errors.Count - 50) ошибок
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (importResult.ErrorMessage != null)
                    {
                        <div class="alert alert-danger mt-3">
                            <strong>Критическая ошибка:</strong> @importResult.ErrorMessage
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center">
            ⚠️ Выберите магазин для начала импорта.
        </div>
    }
</div>

@code {
    private bool isAdminSuper = false;
    private string? currentUserId;
    private Guid? selectedStoreId;
    private List<Store> availableStores = new();
    private IBrowserFile? selectedFile;
    private bool isImporting = false;
    private ExcelImportResult? importResult;
    private ExcelImportSettings settings = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(currentUserId)) return;

        var roles = authState.User.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
        isAdminSuper = roles.Contains("AdminSuper");

        if (isAdminSuper)
        {
            availableStores = await DepartmentService.GetActiveStoresAsync();
        }
        else
        {
            selectedStoreId = await PricingService.GetUserStoreIdAsync(currentUserId);
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        importResult = null;
    }

    private async Task StartImport()
    {
        if (selectedFile == null || !selectedStoreId.HasValue) return;

        isImporting = true;
        importResult = null;
        StateHasChanged();

        try
        {
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024); // 50 МБ
            importResult = await ImportService.ImportFromFileAsync(
                stream,
                selectedFile.Name,
                selectedStoreId.Value,
                currentUserId!,
                settings
            );
        }
        catch (Exception ex)
        {
            importResult = new ExcelImportResult
            {
                ErrorMessage = ex.Message,
                TotalRows = 0
            };
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }
}