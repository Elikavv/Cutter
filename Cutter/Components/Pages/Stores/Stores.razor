<!-- Pages/Stores/Store.razor -->
@page "/stores"
@rendermode InteractiveServer
@using Cutter.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>Магазины</PageTitle>
@if (showNotification && !string.IsNullOrEmpty(notificationMessage))
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 9999;">
        <div class="alert alert-@notificationType alert-dismissible fade show mb-0" role="alert">
            @notificationMessage
            <button type="button" class="btn-close" @onclick="() => showNotification = false"></button>
        </div>
    </div>
}

<div class="mt-4">
    <h3>Магазины</h3>


    <!-- Поиск -->
    <div class="row mb-3">
        <div class="col-md-6">
            <input @bind="searchTerm" @bind:event="oninput" class="form-control" placeholder="Поиск по названию..." />
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-primary" @onclick="OpenCreateModal">➕ Добавить магазин</button>
        </div>
    </div>

    <!-- Спиннер -->
    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Таблица -->
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Адрес</th>
                    <th>Телефон</th>
                    <th>Штрих-код реза</th>
                    <th>Активен</th>
                    <th>Подписка активна</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (PagedStores.Any())
                {
                    @foreach (var store in PagedStores)
                    {
                        <tr>
                            <td>@store.Name</td>
                            <td>@store.Address</td>
                            <td>@store.Phone</td>
                            <td>@store.CutBarCode</td>
                            <td>@(store.IsActive ? "Да" : "Нет")</td>
                            <td class="@(store.IsSubscriptionActive ? "text-success" : "text-danger")">
                                @(store.IsSubscriptionActive ? "✅" : "❌")
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="(() => OpenEditModal(store))">✏️</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="(() => PrepareToDelete(store))">🗑️</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">Нет данных</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Пагинация -->
        @if (TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">Назад</button>
                    </li>
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        <li class="page-item @(CurrentPage == i ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                        </li>
                    }
                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">Вперёд</button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<!-- Модальное окно -->
<StoreModal IsOpen="isModalOpen"
Title="@(editingStore.Id == Guid.Empty ? "Добавить магазин" : "Редактировать магазин")"
Store="editingStore"
OnClose="CloseModal"
OnSave="HandleValidSubmit" />

<!-- Подтверждение удаления -->
@if (storeToDelete != null)
{
    <div class="modal show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Подтвердите удаление</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    Удалить магазин "<strong>@storeToDelete.Name</strong>"?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Отмена</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Удалить</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Store> allStores = new();
    private string searchTerm = "";
    private List<Store> FilteredStores => string.IsNullOrWhiteSpace(searchTerm)
        ? allStores
        : allStores.Where(s => s.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    private int CurrentPage = 1;
    private const int PageSize = 10;
    private int TotalPages => (int)Math.Ceiling(FilteredStores.Count / (double)PageSize);
    private List<Store> PagedStores => FilteredStores
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private bool isNew = false;
    private bool isLoading = true;
    private bool isModalOpen = false;
    private Store editingStore = new();
    private Store? storeToDelete;

    private string? notificationMessage;
    private string notificationType = "success"; // success, info, warning, danger
    private bool showNotification = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadStores();
    }

    private async Task LoadStores()
    {
        isLoading = true;
        StateHasChanged();

        allStores = await DbContext.Stores.ToListAsync();
        CurrentPage = 1;

        isLoading = false;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void OpenCreateModal()
    {
        editingStore = new Store();
        isNew = true;
        isModalOpen = true;
    }

    private void OpenEditModal(Store store)
    {
        editingStore = new Store
            {
                Id = store.Id,
                StoreCode = store.StoreCode,
                Name = store.Name,
                Address = store.Address,
                Phone = store.Phone,
                CutBarCode = store.CutBarCode,
                IsActive = store.IsActive,
                SubscriptionExpiresAt = store.SubscriptionExpiresAt
            };
        isNew = false;
        isModalOpen = true;
    }

    private async Task HandleValidSubmit(Store store)
    {
        try
        {
            if (isNew)
            {
                store.Id = Guid.NewGuid();
                DbContext.Stores.Add(store);
                //await DbContext.SaveChangesAsync();
                //await ShowNotification("Магазин добавлен", "success");
            }
            else
            {
                var existing = await DbContext.Stores.FindAsync(store.Id);
                if (existing != null)
                {
                    existing.Name = store.Name;
                    existing.StoreCode = store.StoreCode;
                    existing.Address = store.Address;
                    existing.Phone = store.Phone;
                    existing.CutBarCode = store.CutBarCode;
                    existing.IsActive = store.IsActive;
                    existing.SubscriptionExpiresAt = store.SubscriptionExpiresAt;
                    //await DbContext.SaveChangesAsync();
                    //await ShowNotification("Магазин обновлён", "info");
                    //ToastService.ShowInfo("Магазин обновлён");
                }
            }

            await DbContext.SaveChangesAsync();
            //isModalOpen = false;
            await LoadStores();
            _ = ShowNotification(isNew ? "Магазин добавлен" : "Магазин обновлён", "success");
        }
        catch (Exception ex)
        {
            await ShowNotification($"Ошибка: {ex.Message}", "danger");
        }
        finally
        {
            isModalOpen = false; // если ещё не закрыто
        }
    }

    private void PrepareToDelete(Store store)
    {
        storeToDelete = store;
    }

    private async Task ConfirmDelete()
    {
        if (storeToDelete == null) return;

        // 👇 1. Сразу закрываем модалку — пользователь уже подтвердил, зачем ему ждать?
        var storeToRemove = storeToDelete; // сохраняем ссылку, чтобы не терять после обнуления
        storeToDelete = null;              // 👈 сразу скрываем модалку
        StateHasChanged();                 // 👈 обновляем UI

        // 👇 2. Запускаем удаление в фоне, но в UI-контексте через InvokeAsync
        await InvokeAsync(async () =>
        {
            try
            {
                DbContext.Stores.Remove(storeToRemove);
                await DbContext.SaveChangesAsync();
                //await ShowNotification("Магазин удалён", "info");
                await LoadStores();
                _ = ShowNotification("Магазин удалён", "info");
            }
            catch (Exception ex)
            {
                _ = ShowNotification($"Ошибка: {ex.Message}", "danger");
            }
        });
    }

    private void CancelDelete()
    {
        storeToDelete = null;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task ShowNotification(string message, string type = "success")
    {
        notificationMessage = message;
        notificationType = type;
        showNotification = true;
        StateHasChanged();

        await Task.Delay(4000); // Показать на 4 секунды
        showNotification = false;
        StateHasChanged();
    }
}