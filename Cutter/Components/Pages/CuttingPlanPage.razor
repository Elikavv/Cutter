    private double CalculateSheetUsage(SheetLayout layout)
    {
        if (CurrentSheet == null || layout.Details == null) return 0;

        var totalArea = CurrentSheet.FirstOrDefault().Width * CurrentSheet.FirstOrDefault().Length;
        var usedArea = layout.Details.Sum(d => d.Width * d.Length);

        return totalArea > 0 ? usedArea / totalArea : 0;
    }

    private double CalculateSheetEfficiency(SheetLayout layout)
    {
        if (CurrentSheet == null || layout.Details == null) return 0;

        var totalArea = CurrentSheet.FirstOrDefault().Width * CurrentSheet.FirstOrDefault().Length;
        var usedArea = layout.Details.Sum(d => d.Width * d.Length);
        var boundingArea = (layout.Details.Max(d => d.X + d.Width) * (layout.Details.Max(d => d.Y + d.Length)));

        return boundingArea > 0 ? usedArea / boundingArea : 0;
    }

