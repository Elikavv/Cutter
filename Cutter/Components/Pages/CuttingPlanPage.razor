    private async Task RenderCurrentSheet()
    {
        if (CurrentLayout.Details == null) return;

        var details = CurrentLayout.Details.Select(d => new
        {
            x = d.X,
            y = d.Y,
            width = d.Width,
            length = d.Length,
            rotated = d.Rotated,
            name = d.Name ?? $"Деталь {d.Width}×{d.Length}"
        }).ToArray();

        foreach(var CurrentSheet in CurrentSheet)
        {
            await ThreeJS.RenderSheet(
                CurrentSheet?.Width ?? 1000,
                CurrentSheet?.Length ?? 2000,
                details);
        }
        StateHasChanged();
    }

