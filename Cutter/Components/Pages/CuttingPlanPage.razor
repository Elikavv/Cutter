    /********SVG Control****/
    private void ResetCuts()
    {
        CurrentCutStep = 0;
        StopAutoPlay();
        StateHasChanged();
    }

    private void NextCut()
    {
        if (CurrentLayout?.CutLines == null) return;
        var maxSteps = CurrentLayout.CutLines.Count(c => c.IsVisible);
        if (CurrentCutStep < maxSteps)
        {
            CurrentCutStep++;
            StateHasChanged();
        }
    }

    private void PrevCut()
    {
        if (CurrentCutStep > 0)
        {
            CurrentCutStep--;
            StateHasChanged();
        }
    }

    private void StartAutoPlay()
    {
        if (IsPlaying) return;
        IsPlaying = true;
        StateHasChanged();

        AutoPlayTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                var maxSteps = CurrentLayout?.CutLines?.Count(c => c.IsVisible) ?? 0;
                if (CurrentCutStep < maxSteps)
                {
                    CurrentCutStep++;
                    StateHasChanged();
                }
                else
                {
                    StopAutoPlay();
                }
            });
        }, null, 0, 800); // 0.8 сек между шагами
    }

    private void StopAutoPlay()
    {
        IsPlaying = false;
        AutoPlayTimer?.Dispose();
        AutoPlayTimer = null;
        StateHasChanged();
    }


