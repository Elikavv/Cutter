@page "/stats/manager"
@attribute [Authorize(Roles = "Manager, AdminSuper")]
@rendermode InteractiveServer
@using Cutter.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Cutter.Services
@inject CuttingService CuttingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Статистика менеджера</PageTitle>

<div class="container-fluid py-4">
    <h2 class="mb-4">📈 Статистика и аналитика</h2>

    <!-- Панель фильтров -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small text-muted">С</label>
                    <input type="date" class="form-control" @bind="StartDate" @bind:after="ApplyFilters" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">По</label>
                    <input type="date" class="form-control" @bind="EndDate" @bind:after="ApplyFilters" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">Сотрудник</label>
                    <select class="form-select" @bind="SelectedUserId" @bind:after="ApplyFilters">
                        <option value="">Все сотрудники</option>
                        @foreach (var user in availableUsers)
                        {
                            <option value="@user.Id">@user.UserName</option>
                        }
                    </select>
                </div>
                <div class="col-md-5 text-end">
                    <div class="btn-group me-2">
                        <button class="btn btn-sm btn-primary" @onclick='() => SetRange("Week")'>Неделя</button>
                        <button class="btn btn-sm btn-primary" @onclick='() => SetRange("Month")'>Месяц</button>
                        <button class="btn btn-sm btn-primary" @onclick='() => SetRange("LastMonth")'>Прошлый месяц</button>
                        <button class="btn btn-sm btn-primary" @onclick='() => SetRange("HalfYear")'>Полгода</button>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilters">Сбросить</button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (stats != null)
    {
        <!-- Вкладки -->
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "overview" ? "active" : "") text-dark"
                        @onclick="ShowOverviewTab" style="color:#212529!important">
                    📊 Обзор и Прогноз
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "employees" ? "active" : "") text-dark"
                        @onclick="ShowEmployeesTab" style="color:#212529!important">
                    👥 Эффективность сотрудников
                </button>
            </li>
        </ul>
        @if (activeTab == "overview")
        {
            <!-- KPI -->
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card border-primary h-100">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Всего бланков</h6>
                            <h3 class="text-primary">@stats.TotalPlans</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-success h-100">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Всего резов</h6>
                            <h3 class="text-success">@stats.TotalCuts</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-info h-100">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Сумма услуг</h6>
                            <h3 class="text-info">@stats.TotalAmount.ToString("N0") ₽</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- График тренда -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Динамика резов и прогноз (скользящее среднее)</h5>
                </div>
                <div class="card-body">
                    <div style="height: 350px;">
                        <canvas id="trendChart"></canvas>
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "employees")
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Рейтинг по сумме услуг</h5>
                        </div>
                        <div class="card-body">
                            <div style="height: 400px;">
                                <canvas id="empChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Детализация</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Сотрудник</th>
                                            <th class="text-end">Сумма</th>
                                            <th class="text-end">Дней</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var emp in stats.EmployeeStats)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@emp.UserName</strong>
                                                    <br /><small class="text-muted">@emp.TotalCuts резов</small>
                                                </td>
                                                <td class="text-end fw-bold">@emp.TotalAmount.ToString("N0") ₽</td>
                                                <td class="text-end">@emp.WorkDays</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<script src="js/chart.js"></script>
<script src="js/dashboard.js"></script>

@code {
    private bool isLoading = true;
    private ManagerStatsDto? stats;
    private string activeTab = "overview";

    private DateTime StartDate = DateTime.Today.AddDays(-30);
    private DateTime EndDate = DateTime.Today;
    private string SelectedUserId = "";

    private List<ApplicationUser> availableUsers = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var managerId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrEmpty(managerId))
        {
            await LoadUsers(managerId);
            await ApplyFilters();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (stats != null)
        {
            await RenderCharts();
        }
    }

    private async Task LoadUsers(string managerId)
    {
        try
        {
            availableUsers = await CuttingService.GetSubordinatesAsync(managerId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки пользователей: {ex.Message}");
            availableUsers = new();
        }
    }

    private async Task ShowOverviewTab()
    {
        activeTab = "overview";
        await RenderCharts();
    }

    private async Task ShowEmployeesTab()
    {
        activeTab = "employees";
        await RenderCharts();
    }

    private async Task ApplyFilters()
    {
        isLoading = true;
        StateHasChanged();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var managerId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrEmpty(managerId)) { isLoading = false; return; }

        try
        {
            stats = await CuttingService.GetManagerStatsAsync(managerId, StartDate, EndDate, string.IsNullOrEmpty(SelectedUserId) ? null : SelectedUserId);

            // Загружаем список пользователей для фильтра (если еще не)
            if (!availableUsers.Any())
            {
                // Простой хак: берем из статистики или делаем отдельный запрос.
                // Лучше добавить метод GetSubordinatesAsync в сервис.
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            //await RenderCharts();
        }
    }

    private async Task RenderCharts()
    {
        if (stats == null) return;

        if (activeTab == "overview")
        {
            await JSRuntime.InvokeVoidAsync("initStatsTrendChart", "trendChart", stats.TrendData);
        }
        else if (activeTab == "employees")
        {
            await JSRuntime.InvokeVoidAsync("initStatsEmployeeChart", "empChart", stats.EmployeeStats);
        }
    }

    private void SetRange(string range)
    {
        var today = DateTime.Today;

        switch (range)
        {
            case "Week":
                // Начало текущей недели (понедельник)
                var dayOfWeek = (int)today.DayOfWeek;
                if (dayOfWeek == 0) dayOfWeek = 7; // Воскресенье = 7
                StartDate = today.AddDays(-(dayOfWeek - 1));
                EndDate = today;
                break;

            case "Month":
                // С первого числа текущего месяца
                StartDate = new DateTime(today.Year, today.Month, 1);
                EndDate = today;
                break;

            case "LastMonth":
                // Прошлый месяц целиком
                var firstDayOfCurrentMonth = new DateTime(today.Year, today.Month, 1);
                EndDate = firstDayOfCurrentMonth.AddDays(-1);
                StartDate = new DateTime(EndDate.Year, EndDate.Month, 1);
                break;

            case "HalfYear":
                // 6 месяцев назад с первого числа
                var sixMonthsAgo = today.AddMonths(-6);
                StartDate = new DateTime(sixMonthsAgo.Year, sixMonthsAgo.Month, 1);
                EndDate = today;
                break;
        }

        _ = ApplyFilters();
    }

    private void ResetFilters()
    {
        EndDate = DateTime.Today;
        StartDate = DateTime.Today.AddDays(-30);
        SelectedUserId = "";
        _ = ApplyFilters();
    }
}