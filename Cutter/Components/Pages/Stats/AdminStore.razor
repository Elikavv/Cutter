@page "/stats/admin"
@attribute [Authorize(Roles = "AdminStore, AdminSuper")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Cutter.Data
@using Newtonsoft.Json
@inject ApplicationDbContext Db
@rendermode InteractiveServer

<PageTitle>Статистика — Администратор</PageTitle>

<div class="container py-4">
    <h2>📊 Сводка по листам за период</h2>

    <!-- Панель фильтров -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text">С</span>
                <InputDate @bind-Value="StartDate" class="form-control" />
                <span class="input-group-text">по</span>
                <InputDate @bind-Value="EndDate" class="form-control" />
                <button class="btn btn-outline-secondary" @onclick="LoadData">Применить</button>
            </div>
        </div>
        <div class="col-md-6">
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-primary" @onclick="@( () => SetDateRange("Week") )">Неделя</button>
                <button type="button" class="btn btn-primary" 
                    @onclick="@(() => SetDateRange("Month"))">
                    Месяц
                </button>
                <button type="button" class="btn btn-primary" 
                    @onclick="@(() => SetDateRange("HalfYear"))">
                    Полгода
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ResetFilters">Сбросить</button>
            </div>
        </div>
    </div>

    <!-- Информация о периоде -->
    @if (groupedEntries.Any())
    {
        <div class="alert alert-info mb-4">
            <strong>Период:</strong> @StartDate.ToString("dd.MM.yyyy") — @EndDate.ToString("dd.MM.yyyy")<br />
            <strong>Записей:</strong> @groupedEntries.Count<br />
            <strong>Всего листов:</strong> @groupedEntries.Sum(g => g.TotalQuantity)<br />
            <strong>Общая стоимость:</strong> <span class="fw-bold">@grandTotal.ToString("N2") ₽</span>
        </div>
    }

    <!-- Таблица сгруппированных листов -->
    <div class="table-responsive">
        <table class="table table-lemanapro table-striped table-hover">
            <thead>
                <tr>
                    <th style="cursor: pointer;" @onclick="() => SortBy(nameof(GroupedSheetEntry.SheetName))">
                        Название листа @GetSortIndicator(nameof(GroupedSheetEntry.SheetName))
                    </th>
                    <th style="cursor: pointer;" @onclick="() => SortBy(nameof(GroupedSheetEntry.Price))">
                        Цена за ед. @GetSortIndicator(nameof(GroupedSheetEntry.Price))
                    </th>
                    <th style="cursor: pointer;" @onclick="() => SortBy(nameof(GroupedSheetEntry.TotalQuantity))">
                        Кол-во @GetSortIndicator(nameof(GroupedSheetEntry.TotalQuantity))
                    </th>
                    <th style="cursor: pointer;" @onclick="() => SortBy(nameof(GroupedSheetEntry.TotalSum))">
                        Сумма @GetSortIndicator(nameof(GroupedSheetEntry.TotalSum))
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="4" class="text-center">Загрузка...</td>
                    </tr>
                }
                else if (!groupedEntries.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center">Нет данных за выбранный период</td>
                    </tr>
                }
                else
                {
                    @foreach (var entry in sortedEntries)
                    {
                        <tr>
                            <td>@entry.SheetName</td>
                            <td class="text-nowrap">@entry.Price.ToString("N2") ₽</td>
                            <td>@entry.TotalQuantity</td>
                            <td class="fw-bold text-nowrap text-start">@entry.TotalSum.ToString("N2") ₽</td>
                        </tr>
                    }
                }
            </tbody>
            @if (groupedEntries.Any())
            {
                <tfoot>
                    <tr>
                        <td colspan="2" class="text-end"><strong>Итого:</strong></td>
                        <td><strong>@groupedEntries.Sum(g => g.TotalQuantity)</strong></td>
                        <td class="fw-bold text-start">@grandTotal.ToString("N2") ₽</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

@code {
    private DateTime StartDate { get; set; }
    private DateTime EndDate { get; set; }
    private bool isLoading = true;

    // Модель группировки: уникальная связка Название + Цена
    private class GroupedSheetEntry
    {
        public string SheetName { get; set; } = "—";
        public double Price { get; set; }
        public int TotalQuantity { get; set; }
        public double TotalSum => TotalQuantity * Price;
    }

    private List<GroupedSheetEntry> groupedEntries = new();
    private double grandTotal => groupedEntries.Sum(x => x.TotalSum);

    // Сортировка
    private string? currentSortColumn;
    private bool isSortAscending = true;

    private IEnumerable<GroupedSheetEntry> sortedEntries
    {
        get
        {
            var query = groupedEntries.AsQueryable();
            if (string.IsNullOrEmpty(currentSortColumn)) return query;

            var property = typeof(GroupedSheetEntry).GetProperty(currentSortColumn);
            if (property == null) return query;

            query = isSortAscending
                ? query.OrderBy(x => property.GetValue(x))
                : query.OrderByDescending(x => property.GetValue(x));

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        EndDate = DateTime.Now;
        StartDate = EndDate.AddMonths(-1); // По умолчанию — месяц
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var cutPlans = await Db.CutPlan
                .Include(cp => cp.User)
                .Where(cp => cp.CreateDate >= StartDate && cp.CreateDate <= EndDate.Date.AddDays(1).AddTicks(-1))
                .ToListAsync();

            var allSheets = new List<(string Name, double Price, int Quantity)>();

            foreach (var cp in cutPlans)
            {
                if (string.IsNullOrWhiteSpace(cp.CuttingPlan)) continue;

                List<CuttingPlan>? planList;
                try
                {
                    planList = JsonConvert.DeserializeObject<List<CuttingPlan>>(cp.CuttingPlan);
                }
                catch
                {
                    continue;
                }

                if (planList == null) continue;

                foreach (var plan in planList) // ← Обрабатываем каждый CuttingPlan в массиве
                {
                    if (plan.SheetLayouts == null) continue;

                    foreach (var layout in plan.SheetLayouts)
                    {
                        var sheet = layout.Sheet;
                        allSheets.Add((
                            Name: sheet.Name ?? "Без названия",
                            Price: sheet.Price,
                            Quantity: sheet.Quantity
                        ));
                    }
                }
            }

            // Группируем по НАЗВАНИЮ + ЦЕНЕ
            groupedEntries = allSheets
                .GroupBy(x => new { x.Name, x.Price })
                .Select(g => new GroupedSheetEntry
                    {
                        SheetName = g.Key.Name,
                        Price = g.Key.Price,
                        TotalQuantity = g.Sum(x => x.Quantity)
                    })
                .OrderByDescending(x => x.TotalSum) // По умолчанию — по сумме (можно убрать, если мешает сортировке)
                .ToList();

            // Сбрасываем пользовательскую сортировку при загрузке
            currentSortColumn = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
            groupedEntries = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            isSortAscending = !isSortAscending;
        }
        else
        {
            currentSortColumn = columnName;
            isSortAscending = true;
        }
        StateHasChanged();
    }

    private string GetSortIndicator(string columnName)
    {
        if (currentSortColumn != columnName) return "";
        return isSortAscending ? " ▲" : " ▼";
    }

    private void SetDateRange(string range)
    {
        var now = DateTime.Now;
        EndDate = now;
        StartDate = range switch
        {
            "Week" => now.AddDays(-7),
            "Month" => now.AddMonths(-1),
            "HalfYear" => now.AddMonths(-6),
            _ => now.AddMonths(-1)
        };
        _ = LoadData();
    }

    private void ResetFilters()
    {
        EndDate = DateTime.Now;
        StartDate = EndDate.AddMonths(-1);
        _ = LoadData();
    }
}