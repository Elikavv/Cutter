@page "/stats/admin"
@attribute [Authorize(Roles = "AdminStore, AdminSuper")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Cutter.Services
@using System.Security.Claims
@inject IStoreStatsService StatsService
@inject IStorePricingService PricingService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS 

<PageTitle>Статистика материалов</PageTitle>

<div class="container-fluid py-4 px-4">
    <h2 class="mb-4" style="color: #0055A4;">📊 Сводная статистика по материалам</h2>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border" role="status" style="color: #0055A4;">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (statsData != null)
    {
        <!-- KPI Карточки (Сразу виден итог) -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm h-100 border-0 text-white" style="background: linear-gradient(135deg, #0055A4 0%, #0077C8 100%);">
                    <div class="card-body">
                        <h6 class="text-uppercase small opacity-75 mb-1">Всего листов</h6>
                        <h2 class="mb-0 fw-bold">@statsData.TotalSheets</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100 border-0 text-white" style="background: linear-gradient(135deg, #F58220 0%, #FF9F43 100%);">
                    <div class="card-body">
                        <h6 class="text-uppercase small opacity-75 mb-1">Общая стоимость</h6>
                        <h2 class="mb-0 fw-bold">@statsData.TotalCost.ToString("N0") ₽</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100 border-0 text-white" style="background: linear-gradient(135deg, #2C3E50 0%, #34495E 100%);">
                    <div class="card-body">
                        <h6 class="text-uppercase small opacity-75 mb-1">Уникальных типов</h6>
                        <h2 class="mb-0 fw-bold">@statsData.UniqueTypes</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100 border-0 text-white" style="background: linear-gradient(135deg, #27AE60 0%, #2ECC71 100%);">
                    <div class="card-body">
                        <h6 class="text-uppercase small opacity-75 mb-1">Средняя цена листа</h6>
                        <h2 class="mb-0 fw-bold">@statsData.AveragePricePerSheet.ToString("N0") ₽</h2>
                    </div>
                </div>
            </div
        </div>

        <!-- Панель фильтров -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label fw-bold small text-muted">ПЕРИод</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">С</span>
                            <input type="date" class="form-control" @bind="startDate" />
                            <span class="input-group-text bg-light">по</span>
                            <input type="date" class="form-control" @bind="endDate" />
                        </div>
                    </div>
                    <div class="col-md-7">
                        <label class="form-label fw-bold small text-muted">БЫСТРЫЙ ВЫБОР</label>
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-outline-primary" @onclick="() => SetDateRange(7)">Неделя</button>
                            <button type="button" class="btn btn-outline-primary" @onclick="() => SetDateRange(30)">Месяц</button>
                            <button type="button" class="btn btn-outline-primary" @onclick="() => SetDateRange(180)">Полгода</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="ResetFilters">Сбросить</button>
                            <button type="button" class="btn text-white ms-2" style="background-color: #0055A4;" @onclick="LoadData">
                                🔄 Применить
                            </button>
                            <button type="button" class="btn btn-success ms-2" @onclick="ExportToExcel" disabled="@(isLoading || currentStoreId == null)">
                                📊 Выгрузить в Excel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Таблица сгруппированных листов -->
        <div class="card shadow-sm">
            <div class="card-header fw-bold text-white" style="background-color: #2C3E50;">
                📋 Детализация по наименованиям
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40%; cursor: pointer;" @onclick="@(() => SortBy("SheetName"))">
                                Название листа @GetSortIndicator("SheetName")
                            </th>
                            <th style="width: 20%; cursor: pointer; text-align: right;" @onclick="@(() => SortBy("Price"))">
                                Цена за ед. @GetSortIndicator("Price")
                            </th>
                            <th style="width: 20%; cursor: pointer; text-align: right;" @onclick="@(() => SortBy("TotalQuantity"))">
                                Кол-во (шт) @GetSortIndicator("TotalQuantity")
                            </th>
                            <th style="width: 20%; cursor: pointer; text-align: right;" @onclick="@(() => SortBy("TotalSum"))">
                                Общая сумма @GetSortIndicator("TotalSum")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!sortedEntries.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    Нет данных за выбранный период
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var entry in sortedEntries)
                            {
                                <tr>
                                    <td class="fw-bold">@entry.SheetName</td>
                                    <td class="text-end">@entry.Price.ToString("N0") ₽</td>
                                    <td class="text-end">
                                        <span class="badge bg-primary fs-6">@entry.TotalQuantity</span>
                                    </td>
                                    <td class="text-end fw-bold" style="color: #0055A4;">@entry.TotalSum.ToString("N0") ₽</td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (sortedEntries.Any())
                    {
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td class="text-end" style="color: #F58220;">ИТОГО:</td>
                                <td></td>
                                <td class="text-end">@statsData.TotalSheets</td>
                                <td class="text-end" style="color: #F58220; font-size: 1.1em;">@statsData.TotalCost.ToString("N0") ₽</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private DateTime startDate = DateTime.Today.AddMonths(-1);
    private DateTime endDate = DateTime.Today;
    private StoreStatsResult? statsData;
    private string? currentUserId;
    private Guid? currentStoreId;

    // Сортировка
    private string sortColumn = "TotalSum"; // По умолчанию сортируем по сумме
    private bool sortAscending = false;     // По умолчанию по убыванию

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(currentUserId))
        {
            currentStoreId = await PricingService.GetUserStoreIdAsync(currentUserId);
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(currentUserId)) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            statsData = await StatsService.GetSheetStatsAsync(currentUserId, startDate, endDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки статистики: {ex.Message}");
            statsData = new StoreStatsResult();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetDateRange(int days)
    {
        endDate = DateTime.Today;
        startDate = endDate.AddDays(-days);
        _ = LoadData();
    }

    private void ResetFilters()
    {
        endDate = DateTime.Today;
        startDate = endDate.AddMonths(-1);
        sortColumn = "TotalSum";
        sortAscending = false;
        _ = LoadData();
    }

    private void SortBy(string columnName)
    {
        if (sortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = columnName;
            sortAscending = false; // Новое поле всегда начинается с убывания (самые большие сверху)
        }
        StateHasChanged();
    }

    private List<SheetStatEntry> sortedEntries
    {
        get
        {
            if (statsData?.Entries == null) return new();

            return sortColumn switch
            {
                "SheetName" => sortAscending 
                    ? statsData.Entries.OrderBy(x => x.SheetName).ToList() 
                    : statsData.Entries.OrderByDescending(x => x.SheetName).ToList(),
                "Price" => sortAscending 
                    ? statsData.Entries.OrderBy(x => x.Price).ToList() 
                    : statsData.Entries.OrderByDescending(x => x.Price).ToList(),
                "TotalQuantity" => sortAscending 
                    ? statsData.Entries.OrderBy(x => x.TotalQuantity).ToList() 
                    : statsData.Entries.OrderByDescending(x => x.TotalQuantity).ToList(),
                "TotalSum" => sortAscending 
                    ? statsData.Entries.OrderBy(x => x.TotalSum).ToList() 
                    : statsData.Entries.OrderByDescending(x => x.TotalSum).ToList(),
                _ => statsData.Entries.OrderByDescending(x => x.TotalSum).ToList()
            };
        }
    }

    private MarkupString GetSortIndicator(string columnName)
    {
        if (sortColumn != columnName) return new MarkupString("");
        return new MarkupString(sortAscending ? " <span style='color: #0055A4;'>▲</span>" : " <span style='color: #0055A4;'>▼</span>");
    }

    private async Task ExportToExcel()
    {
        if (!currentStoreId.HasValue) return;

        var url = $"/api/export/store-stats?storeId={currentStoreId}&startDate={startDate:yyyy-MM-dd}&endDate={endDate:yyyy-MM-dd}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
}