@page "/stats/admin"
@attribute [Authorize(Roles = "AdminStore, AdminSuper")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Cutter.Data
@using Cutter.Services
@using Microsoft.AspNetCore.Authorization
@inject IStoreStatsService StatsService
@inject IStorePricingService PricingService
@inject IStoreDepartmentService DepartmentService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Статистика материалов</PageTitle>

<div class="container-fluid py-4 px-4">
    <h2 class="mb-4" style="color: #0055A4;">📊 Сводная статистика по материалам</h2>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border" role="status" style="color: #0055A4;">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (statsData != null)
    {
        <!-- KPI Карточки (Сразу виден итог) -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm h-100 border-0 text-white" style="background: linear-gradient(135deg, #0055A4 0%, #0077C8 100%);">
                    <div class="card-body">
                        <h6 class="text-uppercase small opacity-75 mb-1">Всего листов</h6>
                        <h2 class="mb-0 fw-bold">@statsData.TotalSheets</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100 border-0 text-white" style="background: linear-gradient(135deg, #F58220 0%, #FF9F43 100%);">
                    <div class="card-body">
                        <h6 class="text-uppercase small opacity-75 mb-1">Общая стоимость</h6>
                        <h2 class="mb-0 fw-bold">@statsData.TotalCost.ToString("N0") ₽</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100 border-0 text-white" style="background: linear-gradient(135deg, #2C3E50 0%, #34495E 100%);">
                    <div class="card-body">
                        <h6 class="text-uppercase small opacity-75 mb-1">Уникальных типов</h6>
                        <h2 class="mb-0 fw-bold">@statsData.UniqueTypes</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100 border-0 text-white" style="background: linear-gradient(135deg, #27AE60 0%, #2ECC71 100%);">
                    <div class="card-body">
                        <h6 class="text-uppercase small opacity-75 mb-1">Средняя цена листа</h6>
                        <h2 class="mb-0 fw-bold">@statsData.AveragePricePerSheet.ToString("N0") ₽</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Панель фильтров -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label fw-bold small text-muted">ПЕРИОД</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">С</span>
                            <input type="date" class="form-control" @bind="startDate" />
                            <span class="input-group-text bg-light">по</span>
                            <input type="date" class="form-control" @bind="endDate" />
                        </div>
                    </div>
                    <div class="col-md-7">
                        <label class="form-label fw-bold small text-muted">БЫСТРЫЙ ВЫБОР</label>
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-outline-primary" @onclick="() => SetDateRange(7)">Неделя</button>
                            <button type="button" class="btn btn-outline-primary" @onclick="() => SetDateRange(30)">Месяц</button>
                            <button type="button" class="btn btn-outline-primary" @onclick="() => SetDateRange(180)">Полгода</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="ResetFilters">Сбросить</button>
                            <button type="button" class="btn text-white ms-2" style="background-color: #0055A4;" @onclick="LoadData">
                                🔄 Применить
                            </button>
                            <button type="button" class="btn btn-success ms-2" @onclick="ExportToExcel" disabled="@(isLoading || currentStoreId == null)">
                                📊 Выгрузить в Excel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Сворачиваемая секция фильтра по отделам -->
        <div class="card shadow-sm mb-4">
            <div class="card-body py-2">
                <button class="btn btn-link p-0 text-decoration-none"
                        @onclick="() => showDeptFilter = !showDeptFilter"
                        style="color: #0055A4;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-chevron-@(showDeptFilter ? "up" : "down") me-1"
                         viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708" />
                    </svg>
                    <strong>Фильтр по отделам и подотделам</strong>
                </button>

                @if (showDeptFilter)
                {
                    <div class="mt-3 border-top pt-3">
                        <div class="d-flex gap-2 mb-3">
                            <button class="btn btn-sm btn-outline-primary" @onclick="SelectAllDepts">✅ Выбрать все</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="DeselectAllDepts">❌ Снять все</button>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="groupByDept" @bind="groupByDepartment" @bind:after="LoadData" />
                            <label class="form-check-label fw-bold text-primary" for="groupByDept">
                                📊 Группировать по отделам и подотделам (с итогами)
                            </label>
                        </div>

                        <div style="max-height: 300px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px; padding: 10px; background: #f8f9fa;">
                            @foreach (var dept in allDepartments)
                            {
                                <div class="mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               id="dept_@dept.Id"
                                               checked="@selectedDepartmentIds.Contains(dept.Id)"
                                               @onchange="e => ToggleDepartment(dept.Id, e.Value)" />
                                        <label class="form-check-label fw-bold text-primary" for="dept_@dept.Id">
                                            📂 @dept.Name
                                        </label>
                                    </div>

                                    @if (subdepartmentsByDept.TryGetValue(dept.Id, out var subdepts) && subdepts.Any())
                                    {
                                        <div class="ms-4 mt-1">
                                            @foreach (var subdept in subdepts)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox"
                                                           id="subdept_@subdept.Id"
                                                           checked="@selectedSubdepartmentIds.Contains(subdept.Id)"
                                                           @onchange="e => ToggleSubdepartment(subdept.Id, dept.Id, e.Value)" />
                                                    <label class="form-check-label text-secondary" for="subdept_@subdept.Id">
                                                        📁 @subdept.Name
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>


        <!-- Таблица сгруппированных листов -->
        <div class="card shadow-sm">
            <div class="card-header fw-bold text-white" style="background-color: #2C3E50;">
                📋 Детализация по наименованиям
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40%; cursor: pointer;" @onclick="@(() => SortBy("SheetName"))">
                                Название листа @GetSortIndicator("SheetName")
                            </th>
                            <th style="width: 20%; cursor: pointer; text-align: right;" @onclick="@(() => SortBy("Price"))">
                                Цена за ед. @GetSortIndicator("Price")
                            </th>
                            <th style="width: 20%; cursor: pointer; text-align: right;" @onclick="@(() => SortBy("TotalQuantity"))">
                                Кол-во (шт) @GetSortIndicator("TotalQuantity")
                            </th>
                            <th style="width: 20%; cursor: pointer; text-align: right;" @onclick="@(() => SortBy("TotalSum"))">
                                Общая сумма @GetSortIndicator("TotalSum")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!sortedEntries.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    Нет данных за выбранный период
                                </td>
                            </tr>
                        }
                        else if (groupByDepartment)
                        {
                            <!-- === РЕЖИМ ГРУППИРОВКИ === -->
                            @foreach (var group in sortedEntries.GroupBy(x => new { x.DepartmentName, x.SubdepartmentName })
                                                               .OrderBy(g => g.Key.DepartmentName)
                                                               .ThenBy(g => g.Key.SubdepartmentName))
                            {
                                <!-- Заголовок группы -->
                                <tr class="table-primary">
                                    <td colspan="4" class="fw-bold">
                                        📂 @group.Key.DepartmentName — 📁 @group.Key.SubdepartmentName
                                    </td>
                                </tr>

                                <!-- Строки группы -->
                                @foreach (var entry in group)
                                {
                                    <tr>
                                        <td class="ps-4">@entry.SheetName</td>
                                        <td class="text-end">@entry.Price.ToString("N0") ₽</td>
                                        <td class="text-end"><span class="badge bg-primary fs-6">@entry.TotalQuantity</span></td>
                                        <td class="text-end fw-bold" style="color: #0055A4;">@entry.TotalSum.ToString("N0") ₽</td>
                                    </tr>
                                }

                                <!-- Итог по группе -->
                                <tr class="table-light fw-bold">
                                    <td colspan="2" class="text-end text-muted">Итого по подотделу:</td>
                                    <td class="text-end">@group.Sum(x => x.TotalQuantity)</td>
                                    <td class="text-end" style="color: #F58220;">@group.Sum(x => x.TotalSum).ToString("N0") ₽</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- === ПЛОСКИЙ СПИСОК (как было) === -->
                            @foreach (var entry in sortedEntries)
                            {
                                <tr>
                                    <td class="fw-bold">@entry.SheetName</td>
                                    <td class="text-end">@entry.Price.ToString("N0") ₽</td>
                                    <td class="text-end">
                                        <span class="badge bg-primary fs-6">@entry.TotalQuantity</span>
                                    </td>
                                    <td class="text-end fw-bold" style="color: #0055A4;">@entry.TotalSum.ToString("N0") ₽</td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (sortedEntries.Any())
                    {
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td class="text-end" style="color: #F58220;">ИТОГО:</td>
                                <td></td>
                                <td class="text-end">@statsData.TotalSheets</td>
                                <td class="text-end" style="color: #F58220; font-size: 1.1em;">@statsData.TotalCost.ToString("N0") ₽</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private DateTime startDate = DateTime.Today.AddMonths(-1);
    private DateTime endDate = DateTime.Today;
    private StoreStatsResult? statsData;
    private string? currentUserId;
    private Guid? currentStoreId;


    // === Фильтр отделов ===
    private bool showDeptFilter = false;
    private List<StoreDepartment> allDepartments = new();
    private Dictionary<int, List<StoreSubdepartment>> subdepartmentsByDept = new();

    private HashSet<int> selectedDepartmentIds = new();
    private HashSet<int> selectedSubdepartmentIds = new();

    private bool groupByDepartment = false; // Флаг группировки по отделам

    // Сортировка
    private string sortColumn = "TotalSum"; // По умолчанию сортируем по сумме
    private bool sortAscending = false;     // По умолчанию по убыванию

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(currentUserId))
        {
            currentStoreId = await PricingService.GetUserStoreIdAsync(currentUserId);
            await LoadDepartmentsForFilter();
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(currentUserId)) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            // ВАЖНО: передаём null только если списки не инициализированы
            // Если пользователь явно снял все галочки — передаём пустой список
            var deptIds = allDepartments.Any() ? selectedDepartmentIds.ToList() : null;
            var subdeptIds = allDepartments.Any() ? selectedSubdepartmentIds.ToList() : null;

            statsData = await StatsService.GetSheetStatsAsync(
                currentUserId,
                startDate,
                endDate,
                deptIds,
                subdeptIds
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки статистики: {ex.Message}");
            statsData = new StoreStatsResult();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetDateRange(int days)
    {
        endDate = DateTime.Today;
        startDate = endDate.AddDays(-days);
        _ = LoadData();
    }

    private void ResetFilters()
    {
        endDate = DateTime.Today;
        startDate = endDate.AddMonths(-1);
        sortColumn = "TotalSum";
        sortAscending = false;

        // Восстанавливаем все галочки
        SelectAllDepts();

        _ = LoadData();
    }


    private void SortBy(string columnName)
    {
        if (sortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = columnName;
            sortAscending = false; // Новое поле всегда начинается с убывания (самые большие сверху)
        }
        StateHasChanged();
    }

    private List<SheetStatEntry> sortedEntries
    {
        get
        {
            if (statsData?.Entries == null) return new();

            return sortColumn switch
            {
                "SheetName" => sortAscending
                    ? statsData.Entries.OrderBy(x => x.SheetName).ToList()
                    : statsData.Entries.OrderByDescending(x => x.SheetName).ToList(),
                "Price" => sortAscending
                    ? statsData.Entries.OrderBy(x => x.Price).ToList()
                    : statsData.Entries.OrderByDescending(x => x.Price).ToList(),
                "TotalQuantity" => sortAscending
                    ? statsData.Entries.OrderBy(x => x.TotalQuantity).ToList()
                    : statsData.Entries.OrderByDescending(x => x.TotalQuantity).ToList(),
                "TotalSum" => sortAscending
                    ? statsData.Entries.OrderBy(x => x.TotalSum).ToList()
                    : statsData.Entries.OrderByDescending(x => x.TotalSum).ToList(),
                _ => statsData.Entries.OrderByDescending(x => x.TotalSum).ToList()
            };
        }
    }

    private MarkupString GetSortIndicator(string columnName)
    {
        if (sortColumn != columnName) return new MarkupString("");
        return new MarkupString(sortAscending ? " <span style='color: #0055A4;'>▲</span>" : " <span style='color: #0055A4;'>▼</span>");
    }

    private async Task LoadDepartmentsForFilter()
    {
        if (!currentStoreId.HasValue) return;

        allDepartments = await DepartmentService.GetDepartmentsWithSubdepartmentsAsync(currentStoreId.Value);

        subdepartmentsByDept.Clear();
        selectedDepartmentIds.Clear();
        selectedSubdepartmentIds.Clear();

        foreach (var dept in allDepartments)
        {
            selectedDepartmentIds.Add(dept.Id);
            var subdepts = dept.Subdepartments?.Where(sd => sd.IsActive).ToList() ?? new List<StoreSubdepartment>();
            subdepartmentsByDept[dept.Id] = subdepts;

            foreach (var sd in subdepts)
            {
                selectedSubdepartmentIds.Add(sd.Id);
            }
        }
    }

    private void ToggleDepartment(int deptId, object? value)
    {
        bool isChecked = value is true;
        if (isChecked)
        {
            selectedDepartmentIds.Add(deptId);
            if (subdepartmentsByDept.TryGetValue(deptId, out var subdepts))
            {
                foreach (var sd in subdepts) selectedSubdepartmentIds.Add(sd.Id);
            }
        }
        else
        {
            selectedDepartmentIds.Remove(deptId);
            if (subdepartmentsByDept.TryGetValue(deptId, out var subdepts))
            {
                foreach (var sd in subdepts) selectedSubdepartmentIds.Remove(sd.Id);
            }
        }
    }

    private void ToggleSubdepartment(int subdeptId, int parentDeptId, object? value)
    {
        bool isChecked = value is true;
        if (isChecked)
        {
            selectedSubdepartmentIds.Add(subdeptId);
            selectedDepartmentIds.Add(parentDeptId); // ВАЖНО: автоматически отмечаем родительский отдел
        }
        else
        {
            selectedSubdepartmentIds.Remove(subdeptId);
        }
    }

    private void SelectAllDepts()
    {
        selectedDepartmentIds.Clear();
        selectedSubdepartmentIds.Clear();
        foreach (var dept in allDepartments)
        {
            selectedDepartmentIds.Add(dept.Id);
            if (subdepartmentsByDept.TryGetValue(dept.Id, out var subdepts))
            {
                foreach (var sd in subdepts) selectedSubdepartmentIds.Add(sd.Id);
            }
        }
    }

    private void DeselectAllDepts()
    {
        selectedDepartmentIds.Clear();
        selectedSubdepartmentIds.Clear();
    }

    private async Task ExportToExcel()
    {
        if (!currentStoreId.HasValue) return;

        // Формируем строки через запятую
        var deptString = selectedDepartmentIds.Any()
            ? string.Join(",", selectedDepartmentIds)
            : null;
        var subdeptString = selectedSubdepartmentIds.Any()
            ? string.Join(",", selectedSubdepartmentIds)
            : null;

        var filterString = "";
        if (!string.IsNullOrEmpty(deptString)) filterString += $"&departmentIds={deptString}";
        if (!string.IsNullOrEmpty(subdeptString)) filterString += $"&subdepartmentIds={subdeptString}";

        // Передаём флаг группировки в Excel
        filterString += $"&groupByDepartment={groupByDepartment.ToString().ToLower()}";

        var url = $"/api/export/store-stats?storeId={currentStoreId}&startDate={startDate:yyyy-MM-dd}&endDate={endDate:yyyy-MM-dd}{filterString}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
}