@page "/user"
@attribute [Authorize(Roles = "User, AdminSuper")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Cutter.Services
@inject CuttingService CuttingService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Моя смена</PageTitle>

<div class="container mt-4">
    <div class="mb-4">
        <a href="/cut" class="btn btn-primary btn-lg shadow-sm">✂️ Новый распил</a>
    </div>

    <!-- Заголовок меняется в зависимости от роли -->
    <h2 class="mb-4">
        @(isAdminSuper ? "Смена всех сотрудников" : "Моя смена") — @DateTime.Today.ToString("dd.MM.yyyy")
    </h2>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (dashboard != null)
    {
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card text-white bg-primary">
                    <div class="card-body text-center">
                        <h5 class="card-title">Бланков</h5>
                        <h2 class="display-4">@dashboard.CuttingPlansCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-success">
                    <div class="card-body text-center">
                        <h5 class="card-title">Резов</h5>
                        <h2 class="display-4">@dashboard.TotalCuts</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-info">
                    <div class="card-body text-center">
                        <h5 class="card-title">Сумма услуг</h5>
                        <h2 class="display-4">@dashboard.TotalServicesAmount.ToString("N0") ₽</h2>
                    </div>
                </div>
            </div>
            @*<div class="col-md-3">
                <div class="card text-white bg-warning">
                    <div class="card-body text-center">
                        <h5 class="card-title">Итого</h5>
                        <h2 class="display-4">@dashboard.TotalAmount.ToString("N0") ₽</h2>
                    </div>
                </div>
            </div>*@
        </div>

        <h4>Сегодняшние бланки</h4>
        @if (dashboard.TodayCuttings.Any())
        {
            <div class="list-group">
                @foreach (var item in dashboard.TodayCuttings)
                {
                    <a href="/cut/@item.GUUID"
                       class="list-group-item list-group-item-action rounded-2 mb-2"
                       style="transition: background-color 0.15s ease; text-decoration: none;"
                       onmouseover="this.style.backgroundColor='#f0f8ff'"
                       onmouseout="this.style.backgroundColor=''">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>Бланк №@item.ShiftNumber</strong>
                                <small class="text-muted ms-1">(@item.NumCut)</small>

                                <!-- Показываем имя сотрудника ТОЛЬКО если это админ -->
                                @if (isAdminSuper && !string.IsNullOrEmpty(item.UserName))
                                {
                                    <span class="badge bg-secondary ms-2">👤 @item.UserName</span>
                                }

                                @if (!string.IsNullOrEmpty(item.Invoice))
                                {
                                    <span class="badge bg-light text-dark ms-2">Договор №@item.Invoice</span>
                                }
                                <br />
                                <small class="text-muted">
                                    Резов: @item.TotalCuts |
                                    Сумма: @item.TotalServicesAmount.ToString("N0") ₽ @*|
                                    Листы: @item.TotalSheetsAmount.ToString("N0") ₽ |
                                    <strong>Итого: @item.TotalAmount.ToString("N0") ₽</strong>*@
                                </small>
                            </div>
                            <span class="badge bg-secondary align-self-center">@item.CreateDate.ToString("HH:mm")</span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                @(isAdminSuper ? "Сегодня сотрудники ещё не создали ни одной распиловки." : "Сегодня вы ещё не создали ни одной распиловки.")
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private bool isAdminSuper = false; // <-- Новый флаг
    private UserDashboardDto? dashboard;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // Проверяем роль админа
            isAdminSuper = user.IsInRole("AdminSuper");

            var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);

            // Передаем userId и флаг isAdminSuper в сервис
            dashboard = await CuttingService.GetUserDashboardAsync(userId, isAdminSuper);
        }

        isLoading = false;
    }
}