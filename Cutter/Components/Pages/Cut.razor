    private async Task CalculateForSource(CuttingSource source)
    {
        if (!source.Details.Any() || source.Sheet == null) return;

        var constraints = source.Constraints ?? new CuttingConstraintProfile
            {
                BladeWidth = 3.2,
                MinDistanceBetweenParts = 0,
                CanRotateParts = true,
                MaxCutLength = 3000,
                MarginTop = 0,
                MarginBottom = 0,
                MarginLeft = 0,
                MarginRight = 0
            };

        var sheetsForCalc = new List<Sheet>();
        for (int i = 0; i < source.Sheet.Quantity; i++)
        {
            var sheetForCalc = source.Sheet.Clone();

            // Прямой маппинг новых точных отступов
            sheetForCalc.MarginTop = constraints.MarginTop;
            sheetForCalc.MarginBottom = constraints.MarginBottom;
            sheetForCalc.MarginLeft = constraints.MarginLeft;
            sheetForCalc.MarginRight = constraints.MarginRight;

            // ЗАЩИТА: MinMargin становится максимальным из 4-х отступов.
            // Это гарантирует, что любой старый код, проверяющий MinMargin,
            // не позволит детали приблизиться к краю ближе, чем позволяет самый строгий новый отступ.
            sheetForCalc.MinMargin = Math.Max(
                Math.Max(constraints.MarginTop, constraints.MarginBottom),
                Math.Max(constraints.MarginLeft, constraints.MarginRight)
            );

            sheetForCalc.BladeWidth = constraints.BladeWidth;
            sheetForCalc.MinDistanceBetweenParts = constraints.MinDistanceBetweenParts;
            sheetForCalc.CanRotateParts = constraints.CanRotateParts;
            sheetForCalc.MaxCutLength = constraints.MaxCutLength;

            sheetsForCalc.Add(sheetForCalc);
        }

        var plan = CuttingService.OptimizeCutting(sheetsForCalc, source.Details);

        source.CalculatedPlan = plan;
        source.IsCutCountManuallyEdited = false;

        var cuttingSvc = source.Services.FirstOrDefault(s => s.IsDefaultCuttingService);
        if (cuttingSvc != null)
        {
            cuttingSvc.Quantity = plan.TotalCuts;
        }

        StateHasChanged();
    }



    // ===== СОХРАНЕНИЕ (всегда обновляет или создаёт) =====
    private async Task SaveAllPlans()
    {
        if (isLocked)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Раскрой от предыдущего дня заблокирован. Редактирование невозможно.");
            return;
        }

        if (!SCut.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", "Добавьте хотя бы одну позицию!");
            return;
        }

        var errors = new List<string>();
        foreach (var source in SCut.Where(s => !s.IsOwnMaterial && s.CalculatedPlan == null))
        {
            if (!source.Services.Any(s => s.Quantity > 0))
                errors.Add($"Позиция '{source.Sheet?.Name}': укажите количество резов");

            if (!source.Details.Any() && source.ManualTaromest == 0)
                errors.Add($"Позиция '{source.Sheet?.Name}': укажите количество таромест");
        }

        if (errors.Any())
        {
            var errorMsg = "Не заполнены обязательные поля:\n" + string.Join("\n", errors);
            await JSRuntime.InvokeVoidAsync("alert", errorMsg);
            hasValidationErrors = true;
            StateHasChanged();
            return;
        }

        // 1. Создаем ОДИН главный план для всего документа ДО цикла
        var mainPlan = new CuttingPlan
            {
                NumCut = this.numCut,
                Invoice = this.Invoice,
                SheetLayouts = new List<SheetLayout>(),
                UnplacedDetails = new List<Detail>(),
                TotalCuts = 0,
                TotalMaterialUsage = 0,
                TotalWastePercentage = 0,
                OptimizationAlgorithm = "N-Stage Guillotine BSP with Collinear Merging"
            };

        // 2. Наполняем его листами из каждой строки
        foreach (var source in SCut)
        {
            if (source.IsOwnMaterial)
            {
                var layout = new SheetLayout
                    {
                        Sheet = new Sheet { Name = source.OwnMaterialName, SKU = "OWN", BarCode = "OWN", CutPrice = 0, Quantity = 1 },
                        CutCount = source.Services.Sum(s => s.Quantity),
                        DetailsCount = source.ManualTaromest,
                        Details = new List<CutDetail>(),
                        CuttingServiceName = source.Services.FirstOrDefault(s => s.IsDefaultCuttingService)?.ServiceName ?? "Резка",
                        Services = source.Services.Select(s => new SheetServiceItem
                        {
                            ServiceId = s.ServiceId,
                            ServiceName = s.ServiceName,
                            ServiceCode = s.ServiceCode,
                            Price = s.Price,
                            Quantity = s.Quantity,
                            IsDefaultCuttingService = s.IsDefaultCuttingService
                        }).ToList()
                    };
                mainPlan.SheetLayouts.Add(layout);
            }
            else if (source.CalculatedPlan != null)
            {
                var mainService = source.Services.FirstOrDefault(s => s.IsDefaultCuttingService);

                // Проходим ТОЛЬКО по листам, которые принадлежат этому источнику
                foreach (var layout in source.CalculatedPlan.SheetLayouts)
                {
                    layout.CuttingServiceName = mainService?.ServiceName ?? "Резка";

                    var layoutServices = new List<SheetServiceItem>();
                    foreach (var s in source.Services)
                    {
                        if (s.IsDefaultCuttingService)
                        {
                            layoutServices.Add(new SheetServiceItem
                                {
                                    ServiceId = s.ServiceId,
                                    ServiceName = s.ServiceName,
                                    ServiceCode = s.ServiceCode,
                                    Price = s.Price,
                                    Quantity = layout.CutCount, // Реальное кол-во резов этого листа
                                    IsDefaultCuttingService = true
                                });
                        }
                        else
                        {
                            layoutServices.Add(new SheetServiceItem
                                {
                                    ServiceId = s.ServiceId,
                                    ServiceName = s.ServiceName,
                                    ServiceCode = s.ServiceCode,
                                    Price = s.Price,
                                    Quantity = s.Quantity,
                                    IsDefaultCuttingService = false
                                });
                        }
                    }
                    layout.Services = layoutServices;
                    layout.DetailsCount = layout.Details.Count; // Реальное кол-во деталей этого листа

                    mainPlan.SheetLayouts.Add(layout);
                }

                if (source.CalculatedPlan.UnplacedDetails != null)
                {
                    mainPlan.UnplacedDetails.AddRange(source.CalculatedPlan.UnplacedDetails);
                }
            }
            else
            {
                var layout = new SheetLayout
                    {
                        Sheet = source.Sheet,
                        CutCount = source.Services.Sum(s => s.Quantity),
                        DetailsCount = source.ManualTaromest,
                        Details = new List<CutDetail>(),
                        CuttingServiceName = source.Services.FirstOrDefault(s => s.IsDefaultCuttingService)?.ServiceName ?? "Резка",
                        Services = source.Services.Select(s => new SheetServiceItem
                        {
                            ServiceId = s.ServiceId,
                            ServiceName = s.ServiceName,
                            ServiceCode = s.ServiceCode,
                            Price = s.Price,
                            Quantity = s.Quantity,
                            IsDefaultCuttingService = s.IsDefaultCuttingService
                        }).ToList()
                    };
                mainPlan.SheetLayouts.Add(layout);
            }
        }

        // 3. Пересчитываем итоги для главного плана перед сохранением
        mainPlan.TotalCuts = mainPlan.SheetLayouts.Sum(l => l.CutCount);
        double totalSheetArea = mainPlan.SheetLayouts.Sum(sl => sl.Sheet.Width * sl.Sheet.Length);
        double totalUsedArea = mainPlan.SheetLayouts.Sum(sl => sl.Details.Sum(d => d.Width * d.Length));
        if (totalSheetArea > 0)
        {
            mainPlan.TotalMaterialUsage = totalUsedArea / totalSheetArea;
            mainPlan.TotalWastePercentage = 100.0 - (mainPlan.TotalMaterialUsage * 100.0);
        }

        // 4. Отправляем на сервер СТРОГО ОДИН план в списке!
        var plansToSave = new List<CuttingPlan> { mainPlan };

        if (!string.IsNullOrEmpty(SavedGuid))
        {
            await CuttingService.UpdateCuttingPlan(SavedGuid, plansToSave, userId, Invoice);
            successMessage = $"Раскрой №{this.numCut} обновлён.";
        }
        else
        {
            SavedGuid = await CuttingService.StoreCuttingPlan(plansToSave, userId, Invoice, true);
            if (!string.IsNullOrEmpty(SavedGuid))
            {
                currentShiftNumber = await CuttingService.GetShiftNumberAsync(userId, SavedGuid);
                successMessage = $"Раскрой №{this.numCut} (№{currentShiftNumber} в смене) сохранён.";
                NavigationManager.NavigateTo($"/cut/{SavedGuid}", forceLoad: false);
            }
        }

        StateHasChanged();
    }

    // ===== ПЕЧАТЬ БЛАНКА =====
    private async Task PrintBlankInNewWindow(PdfPrintMode mode)
    {
        // 1. Если бланк заблокирован (предыдущие дни) — сразу открываем PDF без проверок и сохранения
        if (isLocked)
        {
            if (!string.IsNullOrEmpty(SavedGuid))
            {
                await JSRuntime.InvokeVoidAsync("open", $"/api/pdf/{SavedGuid}?mode={mode}", "_blank");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Ошибка: идентификатор бланка не найден.");
            }
            return; // Выходим, дальше код выполнять не нужно
        }

        // 2. Стандартная логика для ТЕКУЩЕГО дня (с проверками и сохранением)
        if (!SCut.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", "Добавьте хотя бы одну позицию!");
            return;
        }

        var errors = new List<string>();
        foreach (var source in SCut.Where(s => !s.IsOwnMaterial && s.CalculatedPlan == null))
        {
            if (!source.Services.Any(s => s.Quantity > 0))
                errors.Add($"Позиция '{source.Sheet?.Name}': укажите количество резов");

            if (!source.Details.Any() && source.ManualTaromest == 0)
                errors.Add($"Позиция '{source.Sheet?.Name}': укажите количество таромест");
        }

        if (errors.Any())
        {
            var errorMsg = "Не заполнены обязательные поля:\n" + string.Join("\n", errors);
            await JSRuntime.InvokeVoidAsync("alert", errorMsg);
            hasValidationErrors = true;
            StateHasChanged();
            return;
        }

        // Сначала сохраняем/обновляем (только для текущего дня)
        await SaveAllPlans();

        // Открываем PDF в новой вкладке
        if (!string.IsNullOrEmpty(SavedGuid))
        {
            // Преобразуем Enum в строку для URL (Full, BlankOnly или LayoutsOnly)
            var modeString = mode.ToString();
            await JSRuntime.InvokeVoidAsync("open", $"/api/pdf/{SavedGuid}?mode={modeString}", "_blank");

            successMessage = $"Документ открыт в новой вкладке (Режим: {GetModeName(mode)}).";
            StateHasChanged();
        }
    }

    // Вспомогательный метод для красивого названия в уведомлении
    private string GetModeName(PdfPrintMode mode) => mode switch
    {
        PdfPrintMode.Full => "Бланк + Раскрой",
        PdfPrintMode.BlankOnly => "Только Бланк",
        PdfPrintMode.LayoutsOnly => "Только Раскрой",
        _ => "Неизвестно"
    };

