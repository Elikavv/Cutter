    private async Task AddSourceToSCut(Sheet sheet)
    {
        // 1. Снимаем активность со всех остальных позиций
        SCut.ForEach(x => x.IsActive = false);

        // 2. НОВАЯ ЛОГИКА: Проверяем, есть ли уже такой лист в списке (сравниваем по Артикулу/SKU)
        // Исключаем IsOwnMaterial, чтобы свой материал не сливался с магазинным, если артикулы совпадут
        var existingSource = SCut.FirstOrDefault(s => s.Sheet?.SKU == sheet.SKU && !s.IsOwnMaterial);

        if (existingSource != null)
        {
            // Если такой лист уже есть, просто увеличиваем количество и делаем его активным
            existingSource.Sheet.Quantity += 1;
            existingSource.IsActive = true;

            // Если при добавлении из выпадающего списка передается конкретное Quantity > 1,
            // можно использовать: existingSource.Sheet.Quantity += sheet.Quantity;

            StateHasChanged();
            return; // Выходим, новый объект создавать не нужно
        }

        SourceServiceItem? defaultService = null;

        // 2. Пытаемся найти услугу, привязанную к типу материала в админке
        if (sheet.MaterialTypeId.HasValue)
        {
            var materialType = materialTypes.FirstOrDefault(m => m.Id == sheet.MaterialTypeId);

            if (materialType?.DefaultCuttingServiceId.HasValue == true)
            {
                var serviceFromDb = availableStoreServices
                    .FirstOrDefault(s => s.ServiceId == materialType.DefaultCuttingServiceId.Value);

                if (serviceFromDb != null)
                {
                    defaultService = new SourceServiceItem
                        {
                            ServiceId = serviceFromDb.ServiceId,
                            ServiceName = serviceFromDb.ServiceName,
                            ServiceCode = serviceFromDb.ServiceCode,
                            Price = serviceFromDb.Price,
                            IsDefaultCuttingService = true,
                            Quantity = 0
                        };
                }
            }
        }

        // 3. Фолбэк: если в админке услуга не привязана, берем ПЕРВУЮ доступную услугу магазина (обычно это основная резка)
        if (defaultService == null)
        {
            var firstService = availableStoreServices.FirstOrDefault();
            if (firstService != null)
            {
                defaultService = new SourceServiceItem
                    {
                        ServiceId = firstService.ServiceId,
                        ServiceName = firstService.ServiceName,
                        ServiceCode = firstService.ServiceCode,
                        Price = firstService.Price,
                        IsDefaultCuttingService = true,
                        Quantity = 0
                    };
            }
        }

        var defaultConstraints = availableConstraintProfiles.FirstOrDefault(p => p.IsDefault);
        if (defaultConstraints == null)
        {
            // Если профиля нет, создаем базовый
            defaultConstraints = new CuttingConstraintProfile
                {
                    Name = "Стандартный",
                    IsDefault = true,
                    BladeWidth = 3.2,
                    CanRotateParts = true
                };
        }


        // 4. Создаем новую позицию раскроя
        var newSource = new CuttingSource
            {
                Sheet = sheet.Clone(),
                Details = new List<Detail>(),
                IsActive = true,
                IsOwnMaterial = false,
                Constraints = defaultConstraints
            };

        newSource.Sheet.Quantity = 1;

        // 5. Добавляем услугу (если вдруг список услуг магазина пуст, добавляем заглушку)
        if (defaultService != null)
        {
            newSource.Services.Add(defaultService);
        }
        else
        {
            newSource.Services.Add(new SourceServiceItem
                {
                    ServiceName = "Резка",
                    Price = (float)sheet.CutPrice,
                    IsDefaultCuttingService = true,
                    Quantity = 0
                });
        }

        // 6. Добавляем в список и обновляем интерфейс
        SCut.Add(newSource);
        StateHasChanged();
    }

    private async Task AddOwnMaterialSource()
    {
        var service = availableStoreServices.FirstOrDefault(s => s.ServiceId == NewOwnMaterialServiceId);
        if (service == null) return;

        if (NewOwnMaterialCuts == 0 || NewOwnMaterialTaromest == 0)
        {
            hasValidationErrors = true;
            StateHasChanged();
            return;
        }

        SCut.ForEach(x => x.IsActive = false);
        var newSource = new CuttingSource
            {
                IsOwnMaterial = true,
                OwnMaterialName = "Свой материал",
                IsActive = true,
                ManualTaromest = NewOwnMaterialTaromest,
                Sheet = new Sheet { Name = "Свой материал", SKU = "OWN", BarCode = "OWN", Quantity = 1 }
            };

        newSource.Services.Add(new SourceServiceItem
            {
                ServiceId = service.ServiceId,
                ServiceName = service.ServiceName,
                ServiceCode = service.ServiceCode,
                Price = service.Price,
                Quantity = NewOwnMaterialCuts,
                IsDefaultCuttingService = true
            });

        SCut.Add(newSource);
        NewOwnMaterialServiceId = 0;
        NewOwnMaterialCuts = 0;
        NewOwnMaterialTaromest = 0;
        hasValidationErrors = false;
        StateHasChanged();
    }

