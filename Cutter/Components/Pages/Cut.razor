                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="d-flex justify-content-end gap-3 mb-5">
            <button class="btn btn-lg text-white" style="background-color: #0055A4; color: white; border: none;" @onclick="() => PrintBlankInNewWindow(PdfPrintMode.Full)">
                🖨️ Бланк + Раскрой
            </button>
            <button class="btn btn-lg btn-outline-primary" @onclick="() => PrintBlankInNewWindow(PdfPrintMode.BlankOnly)">
                📄 Только Бланк
            </button>
            <button class="btn btn-lg btn-outline-success" @onclick="() => PrintBlankInNewWindow(PdfPrintMode.LayoutsOnly)">
                📐 Только Раскрой
            </button>
            @*<button class="btn btn-success btn-lg" @onclick="SaveAllPlans">
                💾 Сохранить
            </button>*@
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            Список позиций пуст. Выберите режим выше и добавьте материал или услугу.
        </div>
