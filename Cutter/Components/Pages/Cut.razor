@page "/cut"
@page "/cut/{HashId}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Cutter.Data
@using Cutter.Services
@using System.Text.Json
@using System.Security.Claims
@using System.Text
@using static Cutter.Services.PdfCuttingService
@inject CuttingService CuttingService
@inject IStorePricingService PricingService
@inject NavigationManager NavigationManager
@inject CuttingState State
@inject SheetService SheetService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthProvider
@inject IStoreContextService StoreContext
@inject IConstraintProfileService ConstraintService
@implements IDisposable
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Раскрой материалов</PageTitle>

<div class="container-fluid mt-4">
    @if (isLocked)
    {
        <div class="alert alert-danger d-flex align-items-center" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-lock-fill me-2" viewBox="0 0 16 16">
                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2" />
            </svg>
            <div>
                <strong>Раскрой от @(CreateDate?.ToString("dd.MM.yyyy")) заблокирован!</strong> Редактирование запрещено для расчётов предыдущих дней.
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </svg>
            <div>@successMessage</div>
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @*<h2 class="mb-4">Оптимизация раскроя листовых материалов</h2>*@
    <div class="d-flex justify-content-between align-items-center mb-4">
        @*<h2 class="mb-0">Оптимизация раскроя листовых материалов</h2>*@
        @if (!string.IsNullOrEmpty(numCut))
        {
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary fs-5">
                    Бланк №@currentShiftNumber
                </span>
                <small class="text-muted">@numCut</small>
                @if (CreateDate.HasValue && CreateDate.Value.Date < DateTime.Today)
                {
                    <span class="badge bg-warning text-dark ms-2">
                        @(CreateDate?.ToString("dd.MM.yyyy"))
                    </span>
                }
            </div>
        }
        else if (currentShiftNumber > 0)
        {
            <span class="badge bg-secondary fs-6">
                Следующий номер в смене: №@currentShiftNumber
            </span>
        }
    </div>

    <!-- Сворачиваемая секция для дополнительных полей -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <button class="btn btn-link p-0 text-decoration-none"
                    @onclick="() => showAdditionalFields = !showAdditionalFields"
                    style="color: #0055A4;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                     class="bi bi-chevron-@(showAdditionalFields ? "up" : "down") me-1"
                     viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708" />
                </svg>
                <strong>Дополнительно</strong>
            </button>

            @if (showAdditionalFields)
            {
                <div class="mt-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-auto">
                            <label class="form-label mb-0">№ договора:</label>
                        </div>
                        <div class="col">
                            <input @bind="Invoice"
                                   disabled="@isLocked"
                                   placeholder="Введите номер договора"
                                   class="form-control form-control-sm"
                                   style="max-width: 300px;" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Выберите режим добавления позиции</h5>
        </div>
        <div class="card-body">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="modeRadio" id="modeMaterial"
                       checked="@(CurrentMode == 1)"
                       @onchange="() => OnModeChanged(1)"
                       disabled="@isLocked">
                <label class="form-check-label" for="modeMaterial">Материал из базы</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="modeRadio" id="modeOwn"
                       checked="@(CurrentMode == 2)"
                       @onchange="() => OnModeChanged(2)"
                       disabled="@isLocked">
                <label class="form-check-label" for="modeOwn">Товар клиента</label>
            </div>
        </div>
    </div>



    <div class="card mb-4">
        <div class="card-body">
            @if (CurrentMode == 1)
            {
                @*<h5>Материал из базы</h5>*@
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Поиск листа (Штрихкод/Артикул)</label>
                        <input @ref="searchInput" @key="CurrentMode" @bind="searchCode" @bind:event="oninput" @onkeydown="HandleKeyDown" disabled="@isLocked" placeholder="Введите и нажмите Enter" class="form-control" />
                        @if (showErrorSKU)
                        {
                            <div class="invalid-feedback d-block">Товар не найден</div>
                        }
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Или выберите из списка</label>
                        <select class="form-select" @onchange="AddSelectedSheet" disabled="@isLocked">
                            <option value="">-- Выберите лист --</option>
                            @foreach (var sheet in availableSheets)
                            {
                                <option value="@sheet.Id">@sheet.Name (@sheet.Length x @sheet.Width мм) - @sheet.SKU</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">Добавьте детали через кнопку "Детали", затем нажмите "Расчёт"</small>
                    </div>
                </div>
            }
            else if (CurrentMode == 2)
            {
                <h5>Товар клиента — добавление услуг</h5>
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Выберите услугу из справочника</label>
                        <select class="form-select @(NewOwnMaterialServiceId == 0 && hasValidationErrors ? "is-invalid" : "")" @bind="NewOwnMaterialServiceId" disabled="@isLocked">
                            <option value="0">-- Выберите услугу --</option>
                            @foreach (var service in availableStoreServices)
                            {
                                <option value="@service.ServiceId">@service.ServiceName (@service.Price.ToString("F2") ₽/ед.)</option>
                            }
                        </select>
                        @if (NewOwnMaterialServiceId == 0 && hasValidationErrors)
                        {
                            <div class="invalid-feedback d-block">Выберите услугу</div>
                        }
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Кол-во резов <span class="text-danger">*</span></label>
                        <input type="number" class="form-control @(NewOwnMaterialCuts == 0 && hasValidationErrors ? "is-invalid" : "")" @bind="NewOwnMaterialCuts" disabled="@isLocked" min="0" />
                        @if (NewOwnMaterialCuts == 0 && hasValidationErrors)
                        {
                            <div class="invalid-feedback d-block">Укажите количество</div>
                        }
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Таромест <span class="text-danger">*</span></label>
                        <input type="number" class="form-control @(NewOwnMaterialTaromest == 0 && hasValidationErrors ? "is-invalid" : "")" @bind="NewOwnMaterialTaromest" disabled="@isLocked" min="0" />
                        @if (NewOwnMaterialTaromest == 0 && hasValidationErrors)
                        {
                            <div class="invalid-feedback d-block">Укажите количество</div>
                        }
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" @onclick="AddOwnMaterialSource" disabled="@(isLocked || NewOwnMaterialServiceId == 0)">
                            ➕ Добавить
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (SCut.Any(s => s.IsActive))
    {
        var activeSource = SCut.First(s => s.IsActive);
        @if (activeSource.Constraints != null && availableConstraintProfiles.Any())
        {
            <div class="card mb-3 border-primary shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span>⚙️ Ограничения: <strong>@activeSource.Sheet?.Name (@activeSource.Sheet?.SKU)</strong></span>
                    <button class="btn btn-sm btn-light text-primary" @onclick="() => OpenProfileManager()">
                        🛠 Управление всеми профилями
                    </button>
                </div>
                <div class="card-body">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Текущий профиль</label>
                            <select class="form-select" @bind:get="activeSource.Constraints.Id" @bind:set="OnConstraintIdChanging">
                                @foreach (var profile in availableConstraintProfiles)
                                {
                                    <option value="@profile.Id">@(profile.IsDefault ? "⭐ " : "")@profile.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-8" @key="activeSource.Constraints.Id">
                            <div class="d-flex flex-wrap gap-3 text-muted small">
                                <span>🪚 Пила: <strong>@activeSource.Constraints.BladeWidth</strong> мм</span>
                                <span>📏 Отступы: В:<strong>@activeSource.Constraints.MarginTop</strong> Н:<strong>@activeSource.Constraints.MarginBottom</strong> Л:<strong>@activeSource.Constraints.MarginLeft</strong> П:<strong>@activeSource.Constraints.MarginRight</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @if (SCut.Any())
    {
        <div class="card mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Добавленные позиции @(hasValidationErrors ? "⚠️ Есть незаполненные поля" : "")</h5>
                <div class="d-flex flex-column gap-1">
                    <span class="badge bg-dark fs-6">Листы: @SCut.Sum(s => s.SheetTotalPrice).ToString("F2") ₽</span>
                    <span class="badge bg-success fs-6">Услуги: @SCut.Sum(s => s.ServicesTotalPrice).ToString("F2") ₽</span>
                    <span class="badge bg-primary fs-6">Итого: @((SCut.Sum(s => s.SheetTotalPrice) + SCut.Sum(s => s.ServicesTotalPrice)).ToString("F2")) ₽</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle cutting-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 4%">№</th>
                                <th style="width: 15%">Материал</th>
                                <th style="width: 8%">Листов</th>
                                <th style="width: 10%">Стоимость листа</th>
                                <th style="width: 25%">Услуги</th>
                                <th style="width: 8%">Таромест <span class="text-danger">*</span></th>
                                

                                <th style="width: 10%">Стоимость услуг</th>
                                <th style="width: 10%">Итого</th>
                                <th style="width: 12%">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var source in SCut)
                            {
                                bool hasErrorCuts = !source.IsOwnMaterial && source.CalculatedPlan == null && !source.Services.Any(s => s.Quantity > 0);
                                bool hasErrorTaromest = !source.Details.Any() && source.ManualTaromest == 0;

                                <tr class="@(source.IsActive ? "table-active" : "") @(hasErrorCuts || hasErrorTaromest ? "table-warning" : "")" @onclick="() => ActivateSource(source)">
                                    <td>@(SCut.IndexOf(source) + 1)</td>
                                    <td>
                                        @if (source.IsOwnMaterial)
                                        {
                                            <span class="badge bg-secondary">Свой материал</span>
                                        }
                                        else
                                        {
                                            <strong>@source.Sheet?.Name</strong>

                                            <br />
                                            <small class="text-muted">@source.Sheet?.SKU</small>
                                        }
                                    </td>
                                    <td>
                                        @if (!source.IsOwnMaterial && source.Sheet != null)
                                        {
                                            <div class="input-group input-group-sm" style="width: 80px;">
                                                <button class="btn btn-outline-secondary" @onclick:stopPropagation @onclick="() => DecrementSheetQuantity(source)" disabled="@isLocked">-</button>
                                                <input type="number" class="form-control text-center p-1" @bind="source.Sheet.Quantity" disabled="@isLocked" min="1" />
                                                <button class="btn btn-outline-secondary" @onclick:stopPropagation @onclick="() => IncrementSheetQuantity(source)" disabled="@isLocked">+</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td class="text-muted">
                                        @if (!source.IsOwnMaterial && source.Sheet != null)
                                        {
                                            <div>@source.SheetTotalPrice.ToString("F2") ₽</div>
                                            <small class="text-muted">× @source.Sheet.Quantity шт.</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-2">
                                            @foreach (var svc in source.Services)
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-light text-dark border">@svc.ServiceName</span>
                                                    <span class="text-muted small">@svc.Price.ToString("F2") ₽ × </span>

                                                    @if (svc.IsDefaultCuttingService && source.CalculatedPlan != null)
                                                    {
                                                        @if (source.IsCutCountManuallyEdited)
                                                        {
                                                            <div class="input-group input-group-sm" style="width: 100px;">
                                                                <button class="btn btn-outline-secondary" @onclick:stopPropagation @onclick="() => DecrementServiceQuantity(source, svc)" disabled="@isLocked">-</button>
                                                                <input type="number" class="form-control text-center p-1 fw-bold"
                                                                       style="background-color: #fff3cd; border-color: #ffc107;"
                                                                       @bind="svc.Quantity" @bind:event="oninput" disabled="@isLocked" min="0" />
                                                                <button class="btn btn-outline-secondary" @onclick:stopPropagation @onclick="() => IncrementServiceQuantity(source, svc)" disabled="@isLocked">+</button>
                                                            </div>
                                                            <span class="badge bg-warning text-dark ms-1" title="Отредактировано вручную">✎</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success text-white" style="min-width: 60px;">@svc.Quantity</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="input-group input-group-sm" style="width: 100px;">
                                                            <button class="btn btn-outline-secondary" @onclick:stopPropagation @onclick="() => DecrementServiceQuantity(source, svc)" disabled="@isLocked">-</button>
                                                            <input type="number" class="form-control text-center p-1 @(svc.Quantity == 0 && hasValidationErrors ? "is-invalid" : "")"
                                                                   @bind="svc.Quantity" @bind:event="oninput" disabled="@isLocked" min="0" />
                                                            <button class="btn btn-outline-secondary" @onclick:stopPropagation @onclick="() => IncrementServiceQuantity(source, svc)" disabled="@isLocked">+</button>
                                                        </div>
                                                    }

                                                    @if (!svc.IsDefaultCuttingService && !isLocked)
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger py-0 px-1" @onclick:stopPropagation @onclick="() => RemoveServiceFromSource(source, svc)" title="Удалить услугу">×</button>
                                                    }
                                                </div>
                                            }

                                            @if (!isLocked)
                                            {
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <select class="form-select form-select-sm" style="width: 140px;" @bind="source.TempServiceIdToAdd">
                                                        <option value="0">+ Доп. услуга</option>
                                                        @foreach (var availSvc in availableStoreServices)
                                                        {
                                                            if (!source.Services.Any(s => s.ServiceId == availSvc.ServiceId))
                                                            {
                                                                <option value="@availSvc.ServiceId">@availSvc.ServiceName</option>
                                                            }
                                                        }
                                                    </select>
                                                    <button class="btn btn-sm" style="background-color: #0055A4; color: white; border: none;" @onclick:stopPropagation @onclick="() => AddServiceToSource(source)" disabled="@(source.TempServiceIdToAdd == 0)">Добавить</button>
                                                </div>
                                            }
                                        </div>
                                        @if (hasErrorCuts && hasValidationErrors)
                                        {
                                            <div class="text-danger small mt-1">️ Укажите количество резов</div>
                                        }
                                    </td>
                                    <td>
                                        @if (source.Details.Any())
                                        {
                                            <span class="badge bg-info text-dark">@source.Details.Sum(d => d.Quantity) шт.</span>
                                        }
                                        else
                                        {
                                            <div class="input-group input-group-sm" style="width: 100px;">
                                                <button class="btn btn-outline-secondary" @onclick:stopPropagation @onclick="() => DecrementTaromest(source)" disabled="@isLocked">-</button>
                                                <input type="number" class="form-control text-center p-1 @(source.ManualTaromest == 0 && hasValidationErrors ? "is-invalid" : "")"
                                                       @bind="source.ManualTaromest" @bind:event="oninput" disabled="@isLocked" min="0" />
                                                <button class="btn btn-outline-secondary" @onclick:stopPropagation @onclick="() => IncrementTaromest(source)" disabled="@isLocked">+</button>
                                            </div>
                                        }
                                        @if (hasErrorTaromest && hasValidationErrors)
                                        {
                                            <div class="text-danger small mt-1">⚠️ Укажите таромест</div>
                                        }
                                    </td>

                                    <td class="text-primary fw-bold">
                                        @source.ServicesTotalPrice.ToString("F2") ₽
                                    </td>
                                    <td class="fw-bold text-success">
                                        @((source.SheetTotalPrice + source.ServicesTotalPrice).ToString("F2")) ₽
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            @if (!source.IsOwnMaterial && !isLocked)
                                            {
                                                <button class="btn btn-sm btn-primary" @onclick:stopPropagation @onclick="() => OpenDetailsModal(source)" title="Редактировать детали">
                                                    📋 Детали @(source.Details.Any() ? $"({source.Details.Count})" : "")
                                                </button>
                                            }
                                            @if (!source.IsOwnMaterial && source.Details.Any() && !isLocked)
                                            {
                                                <button class="btn btn-sm btn-success" @onclick:stopPropagation @onclick="() => CalculateForSource(source)" title="Рассчитать раскрой">
                                                    ️ Расчёт
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger" @onclick:stopPropagation @onclick="() => RemoveSource(source)" disabled="@isLocked" title="Удалить позицию">
                                                🗑️
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (activeSourceWithPlan != null && activeSourceWithPlan.CalculatedPlan != null)
        {
            <div class="card mb-4">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">📐 Просмотр раскроя: @activeSourceWithPlan.Sheet?.Name</h5>
                    <span class="badge bg-light text-dark">
                        Листов: @activeSourceWithPlan.CalculatedPlan.SheetLayouts.Where(x => !x.IsEmpty).Count() |
                        Резов: @activeSourceWithPlan.CalculatedPlan.TotalCuts |
                        Эффективность: @(activeSourceWithPlan.CalculatedPlan.TotalMaterialUsage.ToString("P1"))
                    </span>
                </div>
                <div class="card-body">
                    @foreach (var sheetLayout in activeSourceWithPlan.CalculatedPlan.SheetLayouts.Where(x => !x.IsEmpty))
                    {
                        <div class="mb-4">
                            <h6>Лист: @sheetLayout.Sheet.Name (@sheetLayout.Sheet.Length × @sheetLayout.Sheet.Width мм) — Артикул: @sheetLayout.Sheet.SKU</h6>
                            <div class="position-relative" style="border: 1px solid #ddd; background: #f8f9fa; border-radius: 8px; padding: 10px;">
                                @((MarkupString)GenerateSheetSvgNormalized(sheetLayout))
                            </div>
                            <div class="mt-2 text-muted small">
                                Деталей на листе: @sheetLayout.Details.Count |
                                Использование материала: @(sheetLayout.MaterialUsage.ToString("P1")) |
                                Резов: @sheetLayout.CutCount
                            </div>

                            <!-- Таблица деталей -->
                            @if (sheetLayout.Details.Any())
                            {
                                <div class="mt-3">
                                    <h6 class="mb-2">Детали на листе:</h6>
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>№</th>
                                                <th>Название</th>
                                                <th>Длина (мм)</th>
                                                <th>Ширина (мм)</th>
                                                <th>Кол-во</th>
                                                <th style="width: 30px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var groups = sheetLayout.Details.GroupBy(d => new { d.Name, d.Length, d.Width }).ToList();
                                            }
                                            @foreach (var group in groups.Select((g, i) => new { Group = g, GroupIdx = i }))
                                            {
                                                <tr class="group-row" data-group="@group.GroupIdx" style="cursor: pointer;"
                                                    onclick="toggleGroupRow(@group.GroupIdx)">
                                                    <td>@(group.GroupIdx + 1)</td>
                                                    <td>@group.Group.Key.Name</td>
                                                    <td>@group.Group.Key.Length</td>
                                                    <td>@group.Group.Key.Width</td>
                                                    <td><span class="badge bg-primary">@group.Group.Count()</span></td>
                                                    <td class="text-center">▼</td>
                                                </tr>

                                                // Подстроки с каждой конкретной деталью
                                                int itemIdx = 0;
                                                foreach (var detail in group.Group)
                                                {
                                                    var globalIdx = sheetLayout.Details.IndexOf(detail);
                                                    <tr class="sub-row" data-group="@group.GroupIdx" data-idx="@globalIdx"
                                                        style="display: none; background: #f8f9fa; cursor: pointer;"
                                                        onclick="highlightDetail(@globalIdx)">
                                                        <td></td>
                                                        <td colspan="4" class="small">
