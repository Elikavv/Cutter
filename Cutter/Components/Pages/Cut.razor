<script>
    window.openPrintWindow = function(htmlContent) {
            var printWindow = window.open('', '_blank');
            if (printWindow) {
                printWindow.document.write(htmlContent);
                printWindow.document.close();
            }
    };



    window.toggleGroupRow = function(groupIdx) {
        var subRows = document.querySelectorAll('tr.sub-row[data-group="' + groupIdx + '"]');
        var isHidden = subRows.length === 0 || subRows[0].style.display === 'none';

        // Скрываем все подстроки
        document.querySelectorAll('tr.sub-row').forEach(function(tr) {
            tr.style.display = 'none';
        });
        document.querySelectorAll('tr.group-row').forEach(function(tr) {
            tr.style.backgroundColor = '';
            tr.style.fontWeight = '';
            tr.querySelector('td:last-child').textContent = '▼';
        });

        if (isHidden && subRows.length > 0) {
            // Показываем подстроки этой группы
            subRows.forEach(function(tr) {
                tr.style.display = '';
            });

            var groupRow = document.querySelector('tr.group-row[data-group="' + groupIdx + '"]');
            if (groupRow) {
                groupRow.style.backgroundColor = '#E3F2FD';
                groupRow.style.fontWeight = 'bold';
                groupRow.querySelector('td:last-child').textContent = '▲';
            }
        }
    };

    window.highlightDetail = function(detailIdx) {
        // Сброс всех выделений
        document.querySelectorAll('svg rect[data-idx]').forEach(function(r) {
            r.classList.remove('sel');
            r.style.fill = 'white';
            r.style.stroke = '#2E7D32';
            r.style.strokeWidth = '2';
        });
        document.querySelectorAll('tr.sub-row').forEach(function(tr) {
            tr.style.backgroundColor = '';
            tr.style.fontWeight = '';
        });

        // Выделяем конкретную деталь
        var rect = document.querySelector('svg rect[data-idx="' + detailIdx + '"]');
        if (rect) {
            rect.classList.add('sel');
            rect.style.fill = '#BBDEFB';
            rect.style.stroke = '#1565C0';
            rect.style.strokeWidth = '3';

            // Подсвечиваем строку
            var detailRow = document.querySelector('tr.sub-row[data-idx="' + detailIdx + '"]');
            if (detailRow) {
                detailRow.style.backgroundColor = '#BBDEFB';
                detailRow.style.fontWeight = 'bold';
                detailRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }
    };

    window.highlightByIndex = function(idx) {
        // Вызываем highlightDetail для совместимости
        window.highlightDetail(idx);
    };

        /*window.focusElement = function(elementRef) {
        if (elementRef) {
            elementRef.focus();
            elementRef.select();
        }
    };*/


    ///// Обработка инпутов деталей в модальном окне
    window.focusElementSafe = function (element) {
        if (element && element.focus) {
            element.focus();
            element.select(); // Выделяет текст для удобного перезаписывания
        }
    };

    // Умная навигация стрелками внутри строки
    // Возвращает true если переход выполнен, false если курсор просто сдвинулся
    window.handleArrowInRow = function (elements, currentIndex, direction) {
        var current = elements[currentIndex];
        if (!current) return false;

        var selStart = current.selectionStart;
        var selEnd = current.selectionEnd;
        var value = current.value || '';
        var needToMove = false;
        var targetIdx = -1;

        // Если есть выделение — переходим на соседнее поле
        if (selStart !== selEnd) {
            needToMove = true;
            targetIdx = direction === 'right' ? currentIndex + 1 : currentIndex - 1;
        }
        // Если курсор в конце и стрелка вправо — переходим
        else if (direction === 'right' && selStart === value.length) {
            needToMove = true;
            targetIdx = currentIndex + 1;
        }
        // Если курсор в начале и стрелка влево — переходим
        else if (direction === 'left' && selStart === 0) {
            needToMove = true;
            targetIdx = currentIndex - 1;
        }

        if (needToMove && targetIdx >= 0 && targetIdx < elements.length && elements[targetIdx]) {
            elements[targetIdx].focus();
            elements[targetIdx].select();
            return true;
        } else {
            // Просто двигаем курсор вручную (т.к. preventDefault сработал)
            if (direction === 'right' && selStart < value.length) {
                current.selectionStart = selStart + 1;
                current.selectionEnd = selStart + 1;
            } else if (direction === 'left' && selStart > 0) {
                current.selectionStart = selStart - 1;
                current.selectionEnd = selStart - 1;
            }
            return false;
        }
    };

    // Блокировка нецифровых символов
    window.blockNonNumeric = function (e) {
        var key = e.key;
        if (key.length === 1 && !/[0-9]/.test(key) &&
            !['Backspace', 'Delete', 'Tab', 'Enter', 'ArrowUp', 'ArrowDown',
              'ArrowLeft', 'ArrowRight', 'Home', 'End', 'Control', 'Shift', 'Alt'].includes(key)) {
            e.preventDefault();
        }
    };

    // Глобальный обработчик — блокирует буквы в полях с классом numeric-only
    document.addEventListener('keydown', function (e) {
        if (e.target && e.target.classList && e.target.classList.contains('numeric-only')) {
            window.blockNonNumeric(e);
        }
    });

</script>

@code {
    [Parameter] public string HashId { get; set; } = default!;


    private Guid? userStoreId;
    private int CurrentMode { get; set; } = 1;
    private string storeCode = string.Empty;
    private bool isLocked { get; set; } = false;
    private string SavedGuid { get; set; } = string.Empty;
    private string Invoice { get; set; } = "";
    private string numCut { get; set; } = "";
    private bool hasValidationErrors = false;
    private string? successMessage = null;
    private DateTime? CreateDate { get; set; }

    private bool showAdditionalFields = false;
    private int currentShiftNumber = 0; // Номер текущего бланка в смене

    private List<CuttingSource> SCut { get; set; } = new List<CuttingSource>();
    private List<Sheet> availableSheets { get; set; } = new();
    private List<AvailableServiceDto> availableStoreServices { get; set; } = new();
    private string userId = string.Empty;

    private CuttingSource? activeSourceWithPlan => SCut.FirstOrDefault(s => s.IsActive && s.CalculatedPlan != null);

    private ElementReference searchInput;
    private string searchCode = "";
    private bool showErrorSKU = false;

    private bool showDetailsModal = false;
    private CuttingSource? detailsModalSource;
    private List<Detail> detailsModalBatch = new();
    private List<MaterialTypeDto> materialTypes = new();

    private int NewOwnMaterialServiceId { get; set; } = 0;
    private int NewOwnMaterialCuts { get; set; } = 0;
    private int NewOwnMaterialTaromest { get; set; } = 0;
    // Для интерактивности деталей
    private string? selectedDetailKey;
    private int selectedDetailCount;

    private Dictionary<int, ElementReference> nameInputs = new();
    private Dictionary<int, ElementReference> lengthInputs = new();
    private Dictionary<int, ElementReference> widthInputs = new();
    private Dictionary<int, ElementReference> quantityInputs = new();

    private List<CuttingConstraintProfile> availableConstraintProfiles = new();

    private bool isProfileModalOpen = false;
    private CuttingConstraintProfile editingProfileInCut = new();
    private bool isEditingExistingProfile = false;


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
            availableSheets = await SheetService.GetActiveSheetsAsync(userId);

            userStoreId = await PricingService.GetUserStoreIdAsync(userId);
            if (userStoreId.HasValue && userStoreId.Value != Guid.Empty)
            {
                var prices = await PricingService.GetStorePricesAsync(userStoreId.Value);
                availableStoreServices = prices.Select(p => new AvailableServiceDto
                    {
                        ServiceId = p.ServiceId,
                        ServiceName = p.ServiceName,
                        ServiceCode = p.ServiceCode,
                        Price = p.Price
                    }).ToList();

                 availableConstraintProfiles = await ConstraintService.GetProfilesAsync(userStoreId.Value);
            }

            materialTypes = await PricingService.GetAllMaterialTypesAsync();

            // Получаем код магазина текущего пользователя
            var userStoreCode = await CuttingService.GetUserStoreCodeAsync(userId);
            storeCode = userStoreCode ?? string.Empty;
            currentShiftNumber = await CuttingService.GetShiftNumberAsync(userId, HashId);

            // ЗАГРУЗКА СУЩЕСТВУЮЩЕГО РАСКРОЯ ПО HASHID
            if (!string.IsNullOrEmpty(HashId))
            {
                var plans = await CuttingService.GetCuttingPlan(HashId);
                CreateDate = await CuttingService.GetCuttingPlanDate(HashId);

                if (CreateDate.HasValue && CreateDate.Value.Date < DateTime.Today)
                {
                    isLocked = true;
                }

                SavedGuid = HashId;

                if (plans != null && plans.Any())
                {
                    var firstPlan = plans.First();
                    Invoice = firstPlan.Invoice ?? "";
                    numCut = firstPlan.NumCut ?? "";
                    SCut.Clear();

                    var groupedLayouts = firstPlan.SheetLayouts.GroupBy(l => l.Sheet?.SKU).ToList();

                    foreach (var group in groupedLayouts)
                    {
                        var firstLayout = group.First();
                        int totalSheetsInGroup = group.Sum(l => l.Sheet?.Quantity ?? 1);

                        var source = new CuttingSource
                            {
                                IsOwnMaterial = firstLayout.Sheet?.SKU == "OWN",
                                Sheet = firstLayout.Sheet,
                                ManualTaromest = group.Sum(l => l.DetailsCount),

                                // === ИСПРАВЛЕНИЕ: Устанавливаем профиль ограничений ===
                                // Берем дефолтный профиль магазина (или можно попытаться сохранить/загрузить конкретный)
                                Constraints = availableConstraintProfiles?.FirstOrDefault(p => p.IsDefault)
                                    ?? availableConstraintProfiles?.FirstOrDefault(),

                                CalculatedPlan = (firstLayout.Details != null && firstLayout.Details.Any()) ? new CuttingPlan
                                {
                                    SheetLayouts = group.ToList(),
                                    UnplacedDetails = firstPlan.UnplacedDetails,
                                    TotalCuts = firstPlan.TotalCuts,
                                    TotalMaterialUsage = firstPlan.TotalMaterialUsage,
                                    TotalWastePercentage = firstPlan.TotalWastePercentage,
                                    OptimizationAlgorithm = firstPlan.OptimizationAlgorithm
                                } : null
                            };

                        if (source.Sheet != null)
                        {
                            source.Sheet.Quantity = totalSheetsInGroup;

                            // === ИСПРАВЛЕНИЕ: Восстанавливаем параметры листа из сохраненных данных ===
                            // Если в сохраненном листе есть конкретные отступы, применяем их к Constraints
                            if (source.Constraints != null)
                            {
                                // Если в Sheet сохранились Margin'ы (из предыдущего расчета), используем их
                                source.Constraints.MarginTop = firstLayout.Sheet?.MarginTop ?? 0;
                                source.Constraints.MarginBottom = firstLayout.Sheet?.MarginBottom ?? 0;
                                source.Constraints.MarginLeft = firstLayout.Sheet?.MarginLeft ?? 0;
                                source.Constraints.MarginRight = firstLayout.Sheet?.MarginRight ?? 0;
                                source.Constraints.BladeWidth = firstLayout.Sheet?.BladeWidth ?? 3.2;
                                source.Constraints.MinDistanceBetweenParts = firstLayout.Sheet?.MinDistanceBetweenParts ?? 0;
                                source.Constraints.CanRotateParts = firstLayout.Sheet?.CanRotateParts ?? true;
                                source.Constraints.MaxCutLength = firstLayout.Sheet?.MaxCutLength ?? 3000;
                            }
                        }

                        if (firstLayout.Services != null && firstLayout.Services.Any())
                        {
                            source.Services = group.SelectMany(l => l.Services ?? new List<SheetServiceItem>())
                                .GroupBy(s => s.ServiceId)
                                .Select(g => new SourceServiceItem
                                    {
                                        ServiceId = g.Key,
                                        ServiceName = g.First().ServiceName,
                                        ServiceCode = g.First().ServiceCode,
                                        Price = g.First().Price,
                                        Quantity = g.Sum(s => s.Quantity),
                                        IsDefaultCuttingService = g.First().IsDefaultCuttingService
                                    }).ToList();
                        }
                        else
                        {
                            source.Services.Add(new SourceServiceItem
                                {
                                    ServiceName = firstLayout.CuttingServiceName ?? "Резка",
                                    Price = (float)(firstLayout.Sheet?.CutPrice ?? 0),
                                    Quantity = group.Sum(l => l.CutCount),
                                    IsDefaultCuttingService = true
                                });
                        }

                        if (group.Any(l => l.Details != null && l.Details.Any()))
                        {
                            source.Details = group.SelectMany(l => l.Details ?? new List<CutDetail>())
                                .Select(d => new Detail
                                    {
                                        Name = d.Name ?? "Деталь",
                                        Length = d.Length,
                                        Width = d.Width,
                                        Quantity = 1,
                                        CanRotate = d.Rotated
                                    }).ToList();
                        }

                        SCut.Add(source);
                    }

                    if (SCut.Any()) SCut.First().IsActive = true;

                    // === ВАЖНО: Обновляем UI после загрузки ===
                    StateHasChanged();
                }
            }
        }

        State.OnChange += StateHasChanged;
    }

