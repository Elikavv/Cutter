    // Универсальная обработка стрелок
    private async Task HandleArrowNavigation(KeyboardEventArgs e, int rowIndex, string fieldType)
    {
        if (e.Key != "ArrowUp" && e.Key != "ArrowDown" && e.Key != "ArrowLeft" && e.Key != "ArrowRight")
        {
            return;
        }

        // Для Left/Right — делегируем умную логику в JS
        if (e.Key == "ArrowLeft" || e.Key == "ArrowRight")
        {
            var direction = e.Key == "ArrowRight" ? "right" : "left";
            var elements = new[]
            {
            nameInputs.GetValueOrDefault(rowIndex),
            lengthInputs.GetValueOrDefault(rowIndex),
            widthInputs.GetValueOrDefault(rowIndex),
            quantityInputs.GetValueOrDefault(rowIndex)
        };
            var currentIndex = fieldType switch
            {
                "name" => 0,
                "Length" => 1,
                "Width" => 2,
                "Quantity" => 3,
                _ => 0
            };

            // JS сам решит: перейти или сдвинуть курсор
            await JSRuntime.InvokeVoidAsync("handleArrowInRow", elements, currentIndex, direction);
            return;
        }

        // Для Up/Down — старая логика
        int targetRow = rowIndex;
        string targetField = fieldType;

        if (e.Key == "ArrowDown")
        {
            if (rowIndex == detailsModalBatch.Count - 1)
            {
                var detail = detailsModalBatch[rowIndex];
                if (detail.Length > 0 || detail.Width > 0)
                {
                    await AddDetailRow();
                    StateHasChanged();
                    await Task.Delay(50);
                    targetRow = rowIndex + 1;
                    targetField = "Length";
                }
            }
        }
        else if (e.Key == "ArrowUp")
        {
            var currentDetail = detailsModalBatch[rowIndex];
            if (rowIndex > 0 && currentDetail.Length == 0 && currentDetail.Width == 0)
            {
                detailsModalBatch.RemoveAt(rowIndex);
                StateHasChanged();
                await Task.Delay(50);
                targetRow = rowIndex - 1;
            }
            else if (rowIndex > 0)
            {
                targetRow = rowIndex - 1;
            }
        }

        ElementReference targetRef = targetField switch
        {
            "name" => nameInputs.GetValueOrDefault(targetRow),
            "Length" => lengthInputs.GetValueOrDefault(targetRow),
            "Width" => widthInputs.GetValueOrDefault(targetRow),
            "Quantity" => quantityInputs.GetValueOrDefault(targetRow),
            _ => default
        };

        if (targetRef.Id != null)
        {
            await Task.Delay(10);
            await JSRuntime.InvokeVoidAsync("focusElementSafe", targetRef);
        }
    }

