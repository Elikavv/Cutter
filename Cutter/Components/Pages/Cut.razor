                detail.Length++;
                break;
            case "Width":
                detail.Width++;
                break;
            case "Quantity":
                detail.Quantity++;
                break;
        }
        StateHasChanged();
    }

    // Декремент значения
    private void DecrementValue(int rowIndex, string fieldType)
    {
        var detail = detailsModalBatch[rowIndex];
        switch (fieldType)
        {
            case "Length":
                if (detail.Length > 0) detail.Length--;
                break;
            case "Width":
                if (detail.Width > 0) detail.Width--;
                break;
            case "Quantity":
                if (detail.Quantity > 1) detail.Quantity--;
                break;
        }
        StateHasChanged();
    }

