    private void ValidateNumericInput(ChangeEventArgs e, int rowIndex, string fieldType)
    {
        var value = e.Value?.ToString() ?? "";
        var detail = detailsModalBatch[rowIndex];

        // Оставляем только цифры
        var numericValue = new string(value.Where(char.IsDigit).ToArray());

        if (int.TryParse(numericValue, out var num))
        {
            switch (fieldType)
            {
                case "Length": detail.Length = Math.Max(0, num); break;
                case "Width": detail.Width = Math.Max(0, num); break;
                case "Quantity": detail.Quantity = Math.Max(1, num); break;
            }
        }
        else if (string.IsNullOrWhiteSpace(numericValue))
        {
            // Если поле очищено, ставим минимальное значение
            switch (fieldType)
            {
                case "Length": detail.Length = 0; break;
                case "Width": detail.Width = 0; break;
                case "Quantity": detail.Quantity = 1; break;
            }
        }
    }
    
